local function performQuickAction(actionName)
    if actionName == "Executor" then
        showQuickExecutor()
    elseif actionName == "Rejoin" then
        get.TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, lp)
    elseif actionName == "Server Hop" then
        loadstring(game:HttpGet("https://github.com/rrixh/skripts/raw/main/serverhop", true))()
    elseif actionName == "Exit Game" then
        game:Shutdown()
    elseif actionName == "Reload Hub" then
        if type(env.LHReloadHub) == "function" then env.LHReloadHub() end
    elseif actionName == "Unload Hub" then
        if type(env.LHRequestClose) == "function" then env.LHRequestClose() end
    elseif actionName == "Undo" then
        if KAVO and KAVO.Undo then KAVO:Undo() end
    elseif actionName == "Save Settings" then
        local ok, err = LHRuntime:SaveSettings()
        if ok then
            LHRuntime.SettingsDirty = false
            LHRuntime:ShowIsland("Save Settings", "Your UI edits were saved.", {Duration = 2.5})
        else
            LHRuntime:Notify("error", "Settings Save Failed", tostring(err), 4, nil, true)
        end
    elseif actionName == "Admin Palette" then
        if env.LHAdminKommandsEnabled and type(env.LHOpenPalette) == "function" then
            env.LHOpenPalette()
        else
            pcall(function() KAVO:SetUIVisible(true) end)
            pcall(function() Window:SelectTab("Admin") end)
            LHRuntime:Notify("warning", "Admin Palette", "Enable Lollypop Admin Kommands [BETA] first.", 4, nil, true)
        end
    end
end


