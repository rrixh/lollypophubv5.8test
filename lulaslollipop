}

env.LHStopOrbit = function()
    local state = env.LHOrbitState
    if state and state.Connection then
        pcall(function() state.Connection:Disconnect() end)
        state.Connection = nil
    end
    if state then
        state.Target = nil
        state.Angle = 0
    end
end

env.LHStartOrbit = function(target, radius, speed)
    env.LHStopOrbit()
    if not target or target == lp then error("Choose another player.") end

    local state = env.LHOrbitState
    state.Target = target
    state.Radius = math.clamp(tonumber(radius) or 5, 2, 30)
    state.Speed = math.clamp(tonumber(speed) or 1.8, 0.15, 10)
    state.Angle = 0

    state.Connection = get.RunService.Heartbeat:Connect(function(dt)
        if state.Target ~= target then return end

        local root = LHRuntime:GetRoot()
        local character = target.Character
        local targetRoot = character and (
            character:FindFirstChild("HumanoidRootPart")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("UpperTorso")
        )

        if not root or not targetRoot or not target.Parent then
            env.LHStopOrbit()
            return
        end

        state.Angle = (state.Angle + ((tonumber(dt) or 0) * state.Speed)) % (math.pi * 2)
        local center = targetRoot.Position
        local position = center + Vector3.new(
            math.cos(state.Angle) * state.Radius,
            0,
            math.sin(state.Angle) * state.Radius
        )

        root.CFrame = CFrame.lookAt(position, center)
    end)
end

