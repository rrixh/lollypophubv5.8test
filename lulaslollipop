local function getSearchTabName(tabName)
    if tabName == "🌟Games🌟" then
        return "Games"
    end
    return tabName
end

local function newTab(name)
    local data = {_name=tostring(name), _sections={}, _sectionOrder={}}
    tabs[data._name] = data
    table.insert(tabOrder, data)
    return data
end

local function section(tabData, name, items)
    items = items or {}
    items._name = tostring(name)
    items._tab = tabData
    table.insert(tabData._sections, items)
    table.insert(tabData._sectionOrder, tostring(name))
    return items
end

local function descriptor(kind, data)
    data = data or {}
    data.kind = kind
    data._pending = {}
    function data:UpdateLabel(value)
        self.text = tostring(value)
        if self._ui and self._ui.UpdateLabel then self._ui:UpdateLabel(self.text) end
    end
    function data:Refresh(values)
        self.options = values or {}
        if self._ui and self._ui.Refresh then self._ui:Refresh(self.options) end
    end
    function data:SetVisible(value)
        self.visible = value and true or false
        if self._ui and self._ui.SetVisible then self._ui:SetVisible(self.visible) end
    end
    return data
end

local function button(name, tip, callback) return descriptor("button", {name=name,tip=tip,callback=callback}) end
local function toggle(name, tip, callback, default) return descriptor("toggle", {name=name,tip=tip,callback=callback,default=default or false}) end
local function textbox(name, tip, callback, placeholder) return descriptor("textbox", {name=name,tip=tip,callback=callback,placeholder=placeholder}) end
local function slider(name, tip, minimum, maximum, callback) return descriptor("slider", {name=name,tip=tip,min=minimum,max=maximum,callback=callback}) end
local function dropdown(name, tip, options, callback) return descriptor("dropdown", {name=name,tip=tip,options=options,callback=callback}) end
local function keybind(name, tip, key, callback) return descriptor("keybind", {name=name,tip=tip,key=key,callback=callback}) end
local function colorpicker(name, tip, defaultColor, callback) return descriptor("colorpicker", {name=name,tip=tip,default=defaultColor,callback=callback}) end
local function label(text) return descriptor("label", {text=text}) end
local function paragraph(title, text) return descriptor("paragraph", {title=title,text=text}) end
local function kredits(config) return descriptor("kredits", {config=config}) end
local function add(sectionData, item) table.insert(sectionData, item); return item end

local function buildHub(window)
    for _, tabData in ipairs(tabOrder) do
        local realTab = window:NewTab(tabData._name)
        tabData._ui = realTab
        local searchTabName = getSearchTabName(tabData._name)
        if searchTabs[searchTabName] and realTab.NewSearchBar then
            tabData._search = realTab:NewSearchBar({
                Placeholder = "Search " .. searchTabName .. "..."
            })
        end
        for _, sectionData in ipairs(tabData._sections) do
            local realSection = realTab:NewSection(sectionData._name)
            sectionData._ui = realSection
            for _, item in ipairs(sectionData) do
                local ui
                if item.kind == "button" then ui = realSection:NewButton(item.name,item.tip,item.callback)
                elseif item.kind == "toggle" then ui = realSection:NewToggle(item.name,item.tip,item.callback)
                elseif item.kind == "textbox" then ui = realSection:NewTextBox(item.name,item.tip,item.callback,item.placeholder)
                elseif item.kind == "slider" then ui = realSection:NewSlider(item.name,item.tip,item.min,item.max,item.callback)
                elseif item.kind == "dropdown" then ui = realSection:NewDropdown(item.name,item.tip,item.options,item.callback)
                elseif item.kind == "keybind" then ui = realSection:NewKeybind(item.name,item.tip,item.key,item.callback)
                elseif item.kind == "colorpicker" then ui = realSection:NewColorPicker(item.name,item.tip,item.default,item.callback)
                elseif item.kind == "label" then ui = realSection:NewLabel(item.text)
                elseif item.kind == "paragraph" and realSection.NewParagraph then ui = realSection:NewParagraph(item.title,item.text)
                elseif item.kind == "kredits" and realSection.NewKreditsCard then ui = realSection:NewKreditsCard(item.config) end
                item._ui = ui
                if item.visible == false and ui and ui.SetVisible then ui:SetVisible(false) end
            end
        end
    end
end

