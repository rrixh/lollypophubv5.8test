do
local antiPausePropertyConnection = nil
local antiPauseHeartbeatConnection = nil

local function diskonnektAntiPause()
if antiPausePropertyConnection then
pcall(function() antiPausePropertyConnection:Disconnect() end)
antiPausePropertyConnection = nil
end
if antiPauseHeartbeatConnection then
pcall(function() antiPauseHeartbeatConnection:Disconnect() end)
antiPauseHeartbeatConnection = nil
end
end

local function setAntiPauseEnabled(enabled, persist)
diskonnektAntiPause()
enabled = enabled == true
env.LHSettings.AntiPause = enabled
env.LHUISettings.AntiPause = enabled

if enabled then
local Players = get.Players
local RunService = get.RunService
local LocalPlayer = Players.LocalPlayer
if LocalPlayer then
local function klearGameplayPaused()
if LocalPlayer.GameplayPaused then LocalPlayer.GameplayPaused = false end
end
antiPausePropertyConnection = LocalPlayer:GetPropertyChangedSignal("GameplayPaused"):Connect(klearGameplayPaused)
antiPauseHeartbeatConnection = RunService.Heartbeat:Connect(klearGameplayPaused)
LHRuntime:Track(antiPausePropertyConnection)
LHRuntime:Track(antiPauseHeartbeatConnection)
klearGameplayPaused()
end
end

if persist ~= false then
LHRuntime:SettingChanged()
-- Anti-Pause always remembers itself even when normal Auto Save Edits is OFF.
LHRuntime:SaveSettings()
end
end

