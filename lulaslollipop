function LHRuntime:Unload(reason)
    if self.Unloading then return end
    self:MarkSessionClean()
    self.Unloading = true
    if env.LHKavo and env.LHKavo.CloseIsland then pcall(function() env.LHKavo:CloseIsland() end) end
    for index = #self.CleanupCallbacks, 1, -1 do
        pcall(self.CleanupCallbacks[index])
        self.CleanupCallbacks[index] = nil
    end
    if self.FlightCleanup then pcall(self.FlightCleanup); self.FlightCleanup = nil end
    for index = #self.Connections, 1, -1 do
        local connection = self.Connections[index]
        pcall(function() if connection and connection.Connected then connection:Disconnect() end end)
        self.Connections[index] = nil
    end
    pcall(function() if env.LHKavo and env.LHKavo.Destroy then env.LHKavo:Destroy() end end)
    pcall(function()
        local blur = get.Lighting:FindFirstChild("LHGlassBlur")
        if blur then blur:Destroy() end
        local music = get.SoundService:FindFirstChild("LHMusicPlayer")
        if music then music:Destroy() end
    end)
    for _, parent in ipairs({get.CoreGui, lp:FindFirstChildOfClass("PlayerGui")}) do
        if parent then
            for _, gui in ipairs(parent:GetChildren()) do
                if gui:IsA("ScreenGui") and (
                    gui.Name == "KustomToggle" or gui.Name == "CustomLoader" or
                    gui.Name == "LHCommandPalette" or gui.Name == "LHCloseConfirmation" or
                    gui.Name == "LHQuickExecutor" or gui.Name == "LHSessionRestorePrompt" or
                    gui.Name:match("^LollypopHubUI_") or gui.Name:match("^LollypopHubNotifications_")
                ) then
                    pcall(function() gui:Destroy() end)
                end
            end
        end
    end
    env.LHOpenPalette = nil
    env.LHTogglePalette = nil
    env.LHClosePalette = nil
    env.LHOpenQuickActions = nil
    env.LHCloseQuickActions = nil
    env.LHSetAdminKommandsEnabled = nil
    env.LHPlaceAdminButton = nil
    env.LHRequestClose = nil
    env.LHReloadHub = nil
    env.LHAdminKommandsEnabled = false
    env.LHNotify = nil
    env.LHFeatures = nil
    env.LHOnlineStatusRefreshRevision = (tonumber(env.LHOnlineStatusRefreshRevision) or 0) + 1
    env.LHKavo = nil
    env.AdminKommands = nil
    env.lhloaded = false
    env.LHBooting = false
    env.LHRuntime = nil
    warn("Lollypop Hub unloaded: " .. tostring(reason or "manual"))
end

