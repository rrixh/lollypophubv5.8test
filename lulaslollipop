local function animateSkript()
    local TweenService = get.TweenService
    local started = tick()
    local totalLoadTime = 5
    local lastPercent = -1

    while true do
        local elapsed = tick() - started
        local alpha = math.clamp(elapsed / totalLoadTime, 0, 1)
        local angleBase = elapsed * 3.6
        for index, orbit in ipairs(orbitLollipops) do
            local angle = angleBase + ((index - 1) / #orbitLollipops) * math.pi * 2
            orbit.Position = UDim2.new(0.5, math.cos(angle) * 34, 0.5, math.sin(angle) * 34)
        end
        local percent = math.floor(alpha * 100 + 0.5)

        if percent ~= lastPercent then
            lastPercent = percent
            milk(percent)
        end

        if not env.LHSettings.ReducedMotion and not env.LHSettings.LowPerformance then
            logo.Rotation = (elapsed * 150) % 360
            local pulse = 64 + math.sin(elapsed * 5) * 4
            logo.Size = UDim2.fromOffset(pulse, pulse)
            for index, particle in ipairs(particles) do
                particle.Position = UDim2.new(
                    particle.Position.X.Scale,
                    particle.Position.X.Offset,
                    (particle.Position.Y.Scale - 0.0035 - index * 0.00005) % 1,
                    particle.Position.Y.Offset
                )
            end
        end

        if alpha >= 1 then break end
        RobloxTask.wait()
    end

    milk(100)
    loadingText.Text = "Successfully Loaded!"
    RobloxTask.wait(0.45)

    if env.LHSettings.ReducedMotion or env.LHSettings.LowPerformance then
        TweenService:Create(frame, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, 0, -0.35, 0),
            BackgroundTransparency = 1
        }):Play()
    else
        TweenService:Create(frame, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Position = UDim2.new(1.28, 0, -0.28, 0),
            Rotation = frame.Rotation + 540,
            Size = UDim2.fromOffset(55, 55),
            BackgroundTransparency = 1
        }):Play()
    end

    RobloxTask.wait(env.LHSettings.ReducedMotion and 0.34 or 0.57)
    if openingSound then pcall(function() openingSound:Destroy() end) end
    loadingSkreen:Destroy()

