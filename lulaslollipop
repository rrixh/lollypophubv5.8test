-- Run legacy remote entries without throwing HTTP/compile/runtime traces through
-- Kavo's kontrol callbacks. A failed remote now becomes one readable LH notice.
function LHRuntime:RunRemote(url, label)
    label = tostring(label or "Remote Skript")
    local httpOk, sourceOrError = LHCompat.HttpGet(url, true)
    if not httpOk then
        self:Notify("error", label, "Remote skript unavailable: " .. tostring(sourceOrError), 6, nil, true)
        return false, sourceOrError
    end

    local compiler, compileError = loadstring(sourceOrError, "LH/" .. label)
    if type(compiler) ~= "function" then
        self:Notify("error", label, "Remote skript could not compile: " .. tostring(compileError), 6, nil, true)
        return false, compileError
    end

    local runOk, result = pcall(compiler)
    if not runOk then
        self:Notify("error", label, "Remote skript failed: " .. tostring(result), 6, nil, true)
        return false, result
    end
    return true, result
end

function LHRuntime:WriteSession(cleanShutdown)
    if not self.SessionSupported or not self.SessionWindow then return false, "session files unavailable" end
    local state = nil
    pcall(function() state = self.SessionWindow:GetUIState() end)

    -- Avoid hammering slower mobile executors with identical file writes. A changed tab,
    -- search, window position, or scroll position still produces a fresh snapshot.
    local stateFingerprint = nil
    pcall(function() stateFingerprint = HttpService:JSONEncode(state or {}) end)
    if cleanShutdown ~= true and stateFingerprint and stateFingerprint == self.LastSessionFingerprint then
        return true, "unchanged"
    end

    local payload = {
        Version = 3,
        HubVersion = Vv,
        Running = cleanShutdown ~= true,
        CleanShutdown = cleanShutdown == true,
        SavedAt = os.time(),
        PlaceId = game.PlaceId,
        JobId = tostring(game.JobId or ""),
        State = state,
    }
    local ok, err = LHCompat.WriteJsonAtomic(LH_SESSION_FILE, payload, LH_SESSION_BACKUP_FILE)
    if ok then
        self.LastSessionWrite = os.clock()
        self.LastSessionFingerprint = stateFingerprint
    end
    return ok, err
end

function LHRuntime:StartSessionPersistence(window)
    self.SessionWindow = window
    if not self.SessionSupported then return false end
    self.SessionWriteRevision = self.SessionWriteRevision + 1
    local revision = self.SessionWriteRevision
    self:WriteSession(false)
    task.spawn(function()
        while not self.Unloading and revision == self.SessionWriteRevision and self.SessionWindow == window do
            task.wait(1.25)
            if not self.Unloading then self:WriteSession(false) end
        end
    end)
    return true
end

function LHRuntime:MarkSessionClean()
    self.SessionWriteRevision = self.SessionWriteRevision + 1
    if self.SessionWindow and self.SessionSupported then
        return self:WriteSession(true)
    end
    return false
end

function LHRuntime:SettingChanged()
    self.SettingsDirty = true
    self.AutoSaveRevision = (self.AutoSaveRevision or 0) + 1
    if not env.LHSettings.AutoSaveEdits then return end

    local revision = self.AutoSaveRevision
    task.delay(0.65, function()
        if self.Unloading or revision ~= self.AutoSaveRevision or not env.LHSettings.AutoSaveEdits then return end
        local ok = self:SaveSettings()
        if ok then self.SettingsDirty = false end
    end)
end

