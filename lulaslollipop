function LHRuntime:AddButtonPressEffect(button)
    if not button or not button:IsA("GuiButton") then return end
    if button:GetAttribute("LHPressEffectBound") then return end
    button:SetAttribute("LHPressEffectBound", true)
    button.ClipsDescendants = true
    local pressTweenService = get.TweenService
    local scaleObject = button:FindFirstChild("LHPressScale") or Instance.new("UIScale")
    scaleObject.Name = "LHPressScale"
    scaleObject.Scale = 1
    scaleObject.Parent = button
    local pressing = false

    local function ripple(inputObject)
        if env.LHSettings.ReducedMotion or env.LHSettings.LowPerformance or not button.Parent then return end
        local absoluteSize = button.AbsoluteSize
        if absoluteSize.X <= 0 or absoluteSize.Y <= 0 then return end
        local absolutePosition = button.AbsolutePosition
        local point = inputObject and inputObject.Position or Vector3.new(
            absolutePosition.X + (absoluteSize.X * 0.5),
            absolutePosition.Y + (absoluteSize.Y * 0.5),
            0
        )
        local diameter = math.max(absoluteSize.X, absoluteSize.Y) * 2.25
        local circle = Instance.new("Frame")
        circle.Name = "LHRipple"
        circle.AnchorPoint = Vector2.new(0.5, 0.5)
        circle.Position = UDim2.fromOffset(point.X - absolutePosition.X, point.Y - absolutePosition.Y)
        circle.Size = UDim2.fromOffset(0, 0)
        circle.BackgroundColor3 = getgenv().LollypopTheme or Color3.fromRGB(255, 72, 176)
        circle.BackgroundTransparency = 0.52
        circle.BorderSizePixel = 0
        circle.Active = false
        circle.ZIndex = math.max(1, button.ZIndex)
        circle.Parent = button
        Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
        pressTweenService:Create(circle, TweenInfo.new(0.34, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(diameter, diameter),
            BackgroundTransparency = 1,
        }):Play()
        task.delay(0.38, function()
            if circle then pcall(function() circle:Destroy() end) end
        end)
    end

    self:Track(button.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            pressing = true
            ripple(inputObject)
            pressTweenService:Create(scaleObject, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.95}):Play()
        end
    end))
    self:Track(button.InputEnded:Connect(function(inputObject)
        if inputObject.UserInputType == Enum.UserInputType.MouseButton1 or inputObject.UserInputType == Enum.UserInputType.Touch then
            pressing = false
            pressTweenService:Create(scaleObject, TweenInfo.new(0.10, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end
    end))
    self:Track(button.MouseLeave:Connect(function()
        if pressing then
            pressing = false
            pressTweenService:Create(scaleObject, TweenInfo.new(0.10, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end
    end))
end

function LHRuntime:Safe(label, callback, ...)
    local args = table.pack(...)
    local ok, result = xpcall(function()
        return callback(table.unpack(args, 1, args.n))
    end, function(err)
        return debug.traceback(tostring(err), 2)
    end)
    if not ok then
        -- Internal kode errors stay in the executor/dev konsole. Do not expose
        -- stack traces or source-line noise to normal LH users as notifications.
        warn("[LH] " .. tostring(label) .. " failed:\n" .. tostring(result))
    end
    return ok, result
end;

