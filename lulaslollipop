                    startPosition.X.Offset + delta.X,
                    startPosition.Y.Offset + delta.Y
                )
                clampMobileOpen()
            end
        end))

        task.defer(env.LHPlaceAdminButton)
        LHRuntime:Track(adminSafeArea:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            if not moved then
