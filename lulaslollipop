local LHFlight = {
    Enabled = false,
    Speed = 50,
    Up = false,
    Down = false,
    NextBindAttempt = 0,
    CharacterConnection = nil,
    RenderConnection = nil,
    Humanoid = nil,
    Root = nil,
    BodyVelocity = nil,
    BodyGyro = nil,
    OriginalPlatformStand = false,
    OriginalAutoRotate = true,
}

function LHFlight:ClearCharacter()
    if self.BodyVelocity then pcall(function() self.BodyVelocity:Destroy() end) end
    if self.BodyGyro then pcall(function() self.BodyGyro:Destroy() end) end
    if self.Humanoid then
        pcall(function()
            self.Humanoid.PlatformStand = self.OriginalPlatformStand == true
            self.Humanoid.AutoRotate = self.OriginalAutoRotate ~= false
            self.Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end
    if self.Root then
        pcall(function()
            self.Root.AssemblyLinearVelocity = Vector3.zero
            self.Root.AssemblyAngularVelocity = Vector3.zero
        end)
    end
    self.Humanoid, self.Root, self.BodyVelocity, self.BodyGyro = nil, nil, nil, nil
end

function LHFlight:BindCharacter()
    self:ClearCharacter()
    if not self.Enabled then return false end
    -- Never wait/yield from RenderStepped while the player is respawning.
    -- CharacterAdded handles the normal rebind and this method safely returns
    -- when the new character is not fully constructed yet.
    local character = lp.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"))
    if not humanoid or not root then return false end

    self.Humanoid = humanoid
    self.Root = root
    self.OriginalPlatformStand = humanoid.PlatformStand
    self.OriginalAutoRotate = humanoid.AutoRotate

    for _, objectName in ipairs({"LHFlightVelocity", "LHFlightGyro"}) do
        local old = root:FindFirstChild(objectName)
        if old then old:Destroy() end
    end

    local velocity = Instance.new("BodyVelocity")
    velocity.Name = "LHFlightVelocity"
    velocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    velocity.P = 1600
    velocity.Velocity = Vector3.zero
    velocity.Parent = root

    local gyro = Instance.new("BodyGyro")
    gyro.Name = "LHFlightGyro"
    gyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    gyro.P = 90000
    gyro.D = 1100
    gyro.CFrame = root.CFrame
    gyro.Parent = root

    self.BodyVelocity = velocity
    self.BodyGyro = gyro
    humanoid.PlatformStand = true
    humanoid.AutoRotate = false
    return true
end

function LHFlight:SetVertical(actionName, inputState)
    local enabled = inputState == Enum.UserInputState.Begin or inputState == Enum.UserInputState.Change
    if actionName == "LHFlyUp" then self.Up = enabled end
    if actionName == "LHFlyDown" then self.Down = enabled end
    return Enum.ContextActionResult.Sink
end

function LHFlight:Enable(speed)
    speed = tonumber(speed)
    if speed then self.Speed = math.clamp(speed, 5, 500) end
    if self.Enabled then
        LHRuntime:Notify("success", "Fly", "Fly speed updated to " .. tostring(self.Speed), 3)
        return true
    end

    self.Enabled = true
    local ContextActionService = get.ContextActionService
    ContextActionService:BindAction("LHFlyUp", function(name, state)
        return self:SetVertical(name, state)
    end, get.UserInputService.TouchEnabled, Enum.KeyCode.Space, Enum.KeyCode.E)
    ContextActionService:BindAction("LHFlyDown", function(name, state)
        return self:SetVertical(name, state)
    end, get.UserInputService.TouchEnabled, Enum.KeyCode.LeftControl, Enum.KeyCode.Q)
    pcall(function()
        ContextActionService:SetTitle("LHFlyUp", "UP")
        ContextActionService:SetTitle("LHFlyDown", "DOWN")
        ContextActionService:SetPosition("LHFlyUp", UDim2.new(1, -160, 1, -180))
        ContextActionService:SetPosition("LHFlyDown", UDim2.new(1, -95, 1, -180))
    end)

    self.CharacterConnection = lp.CharacterAdded:Connect(function()
        task.wait(0.35)
        if self.Enabled then self:BindCharacter() end
    end)
    self:BindCharacter()

    self.RenderConnection = get.RunService.RenderStepped:Connect(function()
        if not self.Enabled then return end
        if not self.Root or not self.Root.Parent or not self.Humanoid or self.Humanoid.Health <= 0 then
            if os.clock() >= (self.NextBindAttempt or 0) then
                self.NextBindAttempt = os.clock() + 0.45
                self:BindCharacter()
            end
            return
        end
        local move = self.Humanoid.MoveDirection
        local vertical = (self.Up and 1 or 0) - (self.Down and 1 or 0)
        local velocity = move * self.Speed + Vector3.new(0, vertical * self.Speed, 0)
        self.BodyVelocity.Velocity = velocity
        self.Humanoid.PlatformStand = true
        self.Humanoid.AutoRotate = false

        local camera = workspace.CurrentCamera
        if camera then
            local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
            if look.Magnitude > 0.001 then
                self.BodyGyro.CFrame = CFrame.lookAt(self.Root.Position, self.Root.Position + look.Unit)
            end
        end
    end)

    LHRuntime:Notify("success", "Fly", "Fly enabled at speed " .. tostring(self.Speed) .. ". Use the UP/DOWN buttons on mobile.", 4)
    return true
end

function LHFlight:Disable()
    if not self.Enabled then return false end
    self.Enabled = false
    self.Up, self.Down = false, false
    if self.CharacterConnection then self.CharacterConnection:Disconnect(); self.CharacterConnection = nil end
    if self.RenderConnection then self.RenderConnection:Disconnect(); self.RenderConnection = nil end
    pcall(function()
        local ContextActionService = get.ContextActionService
        ContextActionService:UnbindAction("LHFlyUp")
        ContextActionService:UnbindAction("LHFlyDown")
    end)
    self:ClearCharacter()
    LHRuntime:Notify("success", "Fly", "Fly disabled.", 3)
    return true
end

