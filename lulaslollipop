local function section(tabData, name, items, hidden)
    if type(items) == "boolean" and hidden == nil then
        hidden = items
        items = nil
    end
    items = type(items) == "table" and items or {}
    local cleanName = tostring(name or "Section")
    cleanName = cleanName:gsub("^%s*%[+%s*", ""):gsub("%s*%]+%s*$", "")
    items._name = cleanName
    items._tab = tabData
    items._hidden = hidden == true
    tabData[tostring(name or cleanName)] = items
    tabData[cleanName] = items
    table.insert(tabData._sections, items)
    table.insert(tabData._sectionOrder, cleanName)
    return items
end

local function descriptor(kind, data)
    data = data or {}
    data.kind = kind
    data._pending = {}
    function data:UpdateLabel(value)
        self.text = tostring(value)
        if self._ui and self._ui.UpdateLabel then self._ui:UpdateLabel(self.text) end
    end
    function data:Refresh(values)
        self.options = values or {}
        if self._ui and self._ui.Refresh then self._ui:Refresh(self.options) end
    end
    function data:SetVisible(value)
        self.visible = value and true or false
        if self._ui and self._ui.SetVisible then self._ui:SetVisible(self.visible) end
    end
    function data:SetValue(value, fire)
        if self._ui and self._ui.SetValue then return self._ui:SetValue(value, fire) end
        self.default = value
        self._currentValue = value
    end
    function data:GetValue()
        if self._ui and self._ui.GetValue then return self._ui:GetValue() end
        return self._currentValue ~= nil and self._currentValue or self.default
    end
    function data:Reset()
        if self._ui and self._ui.Reset then return self._ui:Reset() end
    end
    function data:SetResetDefault(value)
        self.default = value
        if self._ui and self._ui.SetResetDefault then return self._ui:SetResetDefault(value) end
    end
    function data:Fire()
        if self._ui and self._ui.Fire then return self._ui:Fire() end
        if type(self.callback) == "function" then return self.callback() end
    end
    return data
end

