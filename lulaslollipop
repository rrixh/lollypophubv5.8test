-- Central cloned-service access. Supports get.Players, get.ReplicatedStorage,
-- get("Players"), get("ReplicatedStorage"), and every other Roblox service.
get = rawget(env, "LHGetService")
if type(get) ~= "table" then
    local nativeCloneRef = rawget(env, "cloneref") or rawget(env, "clone_ref")
    if type(nativeCloneRef) ~= "function" then
        nativeCloneRef = function(object) return object end
        rawset(env, "cloneref", nativeCloneRef)
    end
    local serviceCache = {}
    local function resolveService(serviceName)
        serviceName = tostring(serviceName or "")
        if serviceName == "" then error("missing service name", 2) end
        if serviceCache[serviceName] then return serviceCache[serviceName] end
        local ok, service = pcall(game.GetService, game, serviceName)
        if not ok then error(service, 2) end
        local clonedOk, cloned = pcall(nativeCloneRef, service)
        service = (clonedOk and cloned) or service
        serviceCache[serviceName] = service
        return service
    end
    get = setmetatable({}, {
        __index = function(_, serviceName)
            return resolveService(serviceName)
        end,
        __call = function(_, serviceName)
            return resolveService(serviceName)
        end,
    })
    rawset(env, "LHGetService", get)
end
rawset(env, "get", get)

