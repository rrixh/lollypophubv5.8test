            local desiredSize = areaSize.X < 430 and 42 or (areaSize.X < 900 and 46 or 50)
            mobileOpen.Size = UDim2.fromOffset(desiredSize, desiredSize)
            if moved then
                clampMobileOpen()
                return
            end

            -- Prefer the REAL Lollypop toggle position. This automatically follows
            -- phone/tablet/PC sizing and any safe-area placement used by KustomToggle.
            local toggleObject = nil
            pcall(function()
                local toggleGui = parent and parent:FindFirstChild("KustomToggle")
                toggleObject = toggleGui and toggleGui:FindFirstChild("LollypopToggle", true) or nil
            end)
            local gap = areaSize.Y < 500 and 5 or 8
            local x, y
            if toggleObject and toggleObject:IsA("GuiObject") and toggleObject.AbsoluteSize.X > 0 then
                local safePos = adminSafeArea.AbsolutePosition
                local togglePos = toggleObject.AbsolutePosition
                local toggleAbsSize = toggleObject.AbsoluteSize
                x = (togglePos.X - safePos.X) + ((toggleAbsSize.X - desiredSize) * 0.5)
                y = (togglePos.Y - safePos.Y) + toggleAbsSize.Y + gap
            else
