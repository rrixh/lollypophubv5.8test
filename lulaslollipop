local proximityTargetLabels = {}
local proximityTargetUserIds = {All = 0}
local selectedProximityTarget = "All"
local proximityTargetDropdown

local function buildProximityTargets(excludedPlayer)
    local labels = {"All"}
    local ids = {All = 0}
    local players = get.Players:GetPlayers()
    table.sort(players, function(a, b) return string.lower(a.Name) < string.lower(b.Name) end)
    for _, player in ipairs(players) do
        if player ~= lp and player ~= excludedPlayer then
            local labelText = "@" .. tostring(player.Name) .. " | " .. tostring(player.DisplayName)
            table.insert(labels, labelText)
            ids[labelText] = player.UserId
        end
    end
    proximityTargetLabels = labels
    proximityTargetUserIds = ids
    return labels
end

