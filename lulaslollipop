local lastLocalCommandText, lastLocalCommandTime = nil, 0
local function runLocalChatCommand(message)
    message = tostring(message or "")
    if not env.LHAdminKommandsEnabled or LHRuntime.Prefix == "" or message:sub(1, #LHRuntime.Prefix) ~= LHRuntime.Prefix then return end
    local now = os.clock()
    if message == lastLocalCommandText and now - lastLocalCommandTime < 0.45 then return end
    lastLocalCommandText, lastLocalCommandTime = message, now
    LHRuntime:ExecuteCommand(message, "chat")
end
