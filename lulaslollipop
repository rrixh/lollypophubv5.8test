proximityTargetDropdown = add(env.LHSkriptsJumpSection, dropdown("Jump Bot Target", "All works for every player, or selekt one player by username and display name.", buildProximityTargets(), function(labelText)
selectedProximityTarget = tostring(labelText or "All")
LHFeatures:SetProximityTarget(proximityTargetUserIds[selectedProximityTarget] or 0)
end, "All"))

local function refreshProximityTargets(leavingPlayer)
    local previousUserId = LHFeatures.ProximityTargetUserId
    proximityTargetDropdown:Refresh(buildProximityTargets(leavingPlayer))
    if previousUserId ~= 0 then
        local foundLabel = nil
        for labelText, userId in pairs(proximityTargetUserIds) do
            if userId == previousUserId then foundLabel = labelText; break end
        end
        if foundLabel then
            selectedProximityTarget = foundLabel
            proximityTargetDropdown:SetValue(foundLabel, false)
        else
            selectedProximityTarget = "All"
            LHFeatures:SetProximityTarget(0)
            proximityTargetDropdown:SetValue("All", false)
            if leavingPlayer then
                LHRuntime:Notify("info", "Jump Bot Target", "Target left. Selekted All players.", 3)
            end
        end
    end
end

