            Transparency = enabled and 0.12 or 1,
            Thickness = enabled and 5.2 or 4.5,
        }):Play()
    end

    local ringOverlay = nil
    local ringOpen = false
    local ringSerial = 0
    local ringAnimationConnection = nil

    local function stopRingAnimation()
        if ringAnimationConnection then
            pcall(function()
                if ringAnimationConnection.Connected then ringAnimationConnection:Disconnect() end
            end)
            ringAnimationConnection = nil
        end
    end

    local function smoothRingProgress(value)
        value = math.clamp(tonumber(value) or 0, 0, 1)
        return 0.5 - (math.cos(value * math.pi) * 0.5)
    end

    local function quadraticPoint(x0, y0, cx, cy, x1, y1, t)
        local inv = 1 - t
        return
            (inv * inv * x0) + (2 * inv * t * cx) + (t * t * x1),
            (inv * inv * y0) + (2 * inv * t * cy) + (t * t * y1)
    end

    local function animateRing(overlay, opening)
        if not overlay or not overlay.Parent then return end
        stopRingAnimation()
        ringSerial = ringSerial + 1
        local serial = ringSerial
        local durationValue = opening and 0.34 or 0.31
        local startedAt = os.clock()

        local originX = tonumber(overlay:GetAttribute("LHOriginX")) or 0
        local originY = tonumber(overlay:GetAttribute("LHOriginY")) or 0
        local ringCenterX = tonumber(overlay:GetAttribute("LHRingCenterX")) or originX
        local ringCenterY = tonumber(overlay:GetAttribute("LHRingCenterY")) or originY
        local radius = tonumber(overlay:GetAttribute("LHRadius")) or 100
        local startGroupTransparency = tonumber(overlay.GroupTransparency) or (opening and 1 or 0)

        local records = {}
        for _, object in ipairs(overlay:GetChildren()) do
            if object:IsA("GuiButton") and object:GetAttribute("LHQuickAction") == true then
                object.Active = false
                local angle = tonumber(object:GetAttribute("LHQuickAngle")) or 0
                local itemSize = tonumber(object:GetAttribute("LHQuickSize")) or 68
                local finalX = tonumber(object:GetAttribute("LHQuickFinalX"))
                    or (ringCenterX + math.cos(angle) * radius)
                local finalY = tonumber(object:GetAttribute("LHQuickFinalY"))
                    or (ringCenterY + math.sin(angle) * radius)

                local startX, startY
                local endX, endY
                local startSize, endSize
                local startRotation, endRotation
                local startTransparency, endTransparency
                local controlX, controlY

                if opening then
                    startX, startY = originX, originY
                    endX, endY = finalX, finalY
                    startSize, endSize = 8, itemSize
                    startRotation, endRotation = -165, 0
                    startTransparency, endTransparency = 1, 0.03

                    local curlAngle = angle - math.rad(68)
                    controlX = originX + math.cos(curlAngle) * radius * 0.76
                    controlY = originY + math.sin(curlAngle) * radius * 0.76

                    object.Position = UDim2.fromOffset(startX, startY)
                    object.Size = UDim2.fromOffset(startSize, startSize)
                    object.Rotation = startRotation
                    object.BackgroundTransparency = startTransparency
                else
                    startX = object.AbsolutePosition.X + (object.AbsoluteSize.X * 0.5)
                    startY = object.AbsolutePosition.Y + (object.AbsoluteSize.Y * 0.5)
                    endX, endY = originX, originY
                    startSize = math.max(8, math.min(object.AbsoluteSize.X, object.AbsoluteSize.Y))
                    endSize = 6
                    startRotation = object.Rotation
                    endRotation = startRotation + 175
                    startTransparency = object.BackgroundTransparency
                    endTransparency = 1

                    local midX = (startX + originX) * 0.5
                    local midY = (startY + originY) * 0.5
                    local curlAngle = angle + math.rad(92)
                    controlX = midX + math.cos(curlAngle) * radius * 0.34
                    controlY = midY + math.sin(curlAngle) * radius * 0.34
                end

                records[#records + 1] = {
                    Button = object,
                    StartX = startX,
                    StartY = startY,
                    ControlX = controlX,
                    ControlY = controlY,
                    EndX = endX,
                    EndY = endY,
                    StartSize = startSize,
                    EndSize = endSize,
                    StartRotation = startRotation,
                    EndRotation = endRotation,
                    StartTransparency = startTransparency,
                    EndTransparency = endTransparency,
                }
            end
        end

        local center = overlay:FindFirstChild("QuickActionsCenter")
        local centerStartX, centerStartY, centerEndX, centerEndY
        local centerStartSize, centerEndSize
        if center and center:IsA("GuiButton") then
            center.Active = false
            if opening then
                centerStartX, centerStartY = originX, originY
                centerEndX, centerEndY = ringCenterX, ringCenterY
                centerStartSize = math.max(12, center.AbsoluteSize.X * 0.62)
                centerEndSize = tonumber(overlay:GetAttribute("LHCenterSize")) or math.max(center.AbsoluteSize.X, 50)
                center.Position = UDim2.fromOffset(originX, originY)
                center.Size = UDim2.fromOffset(centerStartSize, centerStartSize)
                center.Rotation = -32
            else
                centerStartX = center.AbsolutePosition.X + (center.AbsoluteSize.X * 0.5)
                centerStartY = center.AbsolutePosition.Y + (center.AbsoluteSize.Y * 0.5)
                centerEndX, centerEndY = originX, originY
                centerStartSize = math.max(12, math.min(center.AbsoluteSize.X, center.AbsoluteSize.Y))
                centerEndSize = math.max(12, centerStartSize * 0.62)
            end
        end

        ringAnimationConnection = get.RunService.RenderStepped:Connect(function()
            if serial ~= ringSerial or not overlay.Parent then
                stopRingAnimation()
                return
            end

            local rawProgress = math.clamp((os.clock() - startedAt) / durationValue, 0, 1)
            local progress = smoothRingProgress(rawProgress)

            for _, record in ipairs(records) do
                local button = record.Button
                if button and button.Parent then
                    local x, y = quadraticPoint(
                        record.StartX, record.StartY,
                        record.ControlX, record.ControlY,
                        record.EndX, record.EndY,
                        progress
                    )
                    local size = record.StartSize + ((record.EndSize - record.StartSize) * progress)
                    button.Position = UDim2.fromOffset(x, y)
                    button.Size = UDim2.fromOffset(size, size)
                    button.Rotation = record.StartRotation + ((record.EndRotation - record.StartRotation) * progress)
                    button.BackgroundTransparency = record.StartTransparency
                        + ((record.EndTransparency - record.StartTransparency) * progress)
                end
            end

            if center and center.Parent then
                local centerX = centerStartX + ((centerEndX - centerStartX) * progress)
                local centerY = centerStartY + ((centerEndY - centerStartY) * progress)
                local centerSize = centerStartSize + ((centerEndSize - centerStartSize) * progress)
                center.Position = UDim2.fromOffset(centerX, centerY)
                center.Size = UDim2.fromOffset(centerSize, centerSize)
                if opening then
                    center.Rotation = -32 + (32 * progress)
                else
                    center.Rotation = (tonumber(center.Rotation) or 0) + (4.5 * rawProgress)
                end
            end

            if opening then
                overlay.GroupTransparency = 1 - progress
            else
                overlay.GroupTransparency = startGroupTransparency + ((1 - startGroupTransparency) * progress)
            end

            if rawProgress >= 1 then
                stopRingAnimation()
                if opening then
                    overlay.GroupTransparency = 0
                    if center and center.Parent then center.Active = true; center.Rotation = 0 end
                    for _, record in ipairs(records) do
                        if record.Button and record.Button.Parent then record.Button.Active = true end
                    end
                else
                    if ringOverlay == overlay then ringOverlay = nil end
                    if overlay.Parent then overlay:Destroy() end
                end
            end
        end)
    end

    local function closeRing(immediate)
        ringOpen = false
        local overlay = ringOverlay
        if not overlay or not overlay.Parent then
            ringOverlay = nil
            stopRingAnimation()
            return
        end

        if immediate == true then
            ringSerial = ringSerial + 1
            stopRingAnimation()
            if ringOverlay == overlay then ringOverlay = nil end
            overlay:Destroy()
            return
        end

        overlay.Active = false
        animateRing(overlay, false)
    end

