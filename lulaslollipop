            dragging = false
            dragInput = nil
            dragStart = nil
            startPosition = nil
            if shouldClamp ~= false then
                task.defer(clampMobileOpen)
            end
        end

        env.LHCancelAdminButtonDrag = function()
            finishAdminButtonDrag(false)
        end
        env.LHClampAdminButton = clampMobileOpen

        LHRuntime:Track(mobileOpen.InputBegan:Connect(function(inputObject)
