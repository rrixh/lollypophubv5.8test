function LHCompat.HttpGet(url, useCache)
    url = tostring(url or "")
    if url == "" then return false, "missing URL" end
    local failures = {}

    if LHCompat.Native.Request then
        local requestOk, response = pcall(LHCompat.Native.Request, {
            Url = url,
            Method = "GET",
            Headers = {
                ["Accept"] = "*/*",
                ["User-Agent"] = "Roblox/LollypopHub-10.5.7",
            },
        })
        if requestOk and type(response) == "table" then
            local status = tonumber(response.StatusCode or response.Status or response.status_code or 0) or 0
            local body = response.Body or response.body
            if status >= 200 and status < 300 and type(body) == "string" and #body > 0 then
                return true, body, status
            end
            table.insert(failures, "request HTTP " .. tostring(status > 0 and status or "unknown"))
        elseif not requestOk then
            table.insert(failures, "request error: " .. tostring(response))
        end
    end

    local gameOk, body = pcall(function() return game:HttpGet(url, useCache ~= false) end)
    if gameOk and type(body) == "string" and #body > 0 then return true, body, 200 end
    if not gameOk then table.insert(failures, "game:HttpGet error: " .. tostring(body)) end
    return false, (#failures > 0 and table.concat(failures, "; ") or "empty HTTP response")
end

function LHCompat.LoadRemote(url, chunkName, optional)
    local ok, sourceOrError = LHCompat.HttpGet(url, true)
    if not ok then
        local message = "HTTP load failed for " .. tostring(url) .. ": " .. tostring(sourceOrError)
        if optional then warn("[Lollypop Hub Optional] " .. message); return false, message end
        return false, message
    end
    local compiler, compileError = loadstring(sourceOrError, chunkName or tostring(url))
    if not compiler then
        local message = "compile failed for " .. tostring(chunkName or url) .. ": " .. tostring(compileError)
        if optional then warn("[Lollypop Hub Optional] " .. message); return false, message end
        return false, message
    end
    local runOk, result = pcall(compiler)
    if not runOk then
        local message = "runtime failed for " .. tostring(chunkName or url) .. ": " .. tostring(result)
        if optional then warn("[Lollypop Hub Optional] " .. message); return false, message end
        return false, message
    end
    return true, result
end

