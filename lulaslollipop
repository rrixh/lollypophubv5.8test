local NAMELESS_ADMIN_URL = env.LH_NAMELESS_ADMIN_URL or "https://raw.githubusercontent.com/ltseverydayyou/Nameless-Admin/main/Source.lua"
local namelessLoading = false
local namelessOwnedGuis = setmetatable({}, {__mode = "k"})
local namelessGuiLocks = setmetatable({}, {__mode = "k"})

local function getAdminGuiRoots()
    local roots = {get.CoreGui, get.Players.LocalPlayer:WaitForChild("PlayerGui")}
    pcall(function()
        if gethui then
            local hui = gethui()
            if hui and not table.find(roots, hui) then table.insert(roots, hui) end
        end
    end)
    return roots
end

local function hideBackendGui(gui)
    if typeof(gui) ~= "Instance" then return end
    local screen = gui:IsA("ScreenGui") and gui or gui:FindFirstAncestorWhichIsA("ScreenGui")
    if screen then
        local screenName = tostring(screen.Name or "")
        if screen:GetAttribute("LHProtectedUI") or screenName == "LHCommandPalette" or
           screenName == "LHAdminButton" or screenName == "KustomToggle" or
           screenName:match("^LollypopHubUI_") then
            return
        end
        namelessOwnedGuis[screen] = true
        pcall(function()
            screen.Enabled = false
            screen.DisplayOrder = -100000
            screen.Name = "LollypopAdminBackendHidden"
        end)
        if not namelessGuiLocks[screen] then
            local ok, connection = pcall(function()
                return screen:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if screen and screen.Parent and screen.Enabled then
                        screen.Enabled = false
                    end
                end)
            end)
            if ok and connection then
                namelessGuiLocks[screen] = connection
                LHRuntime:Track(connection)
            end
        end
    end
end

local function hideNamelessAdminUI()
    local possible = {
        env.NA_UI_INSTANCE, env.NA_RAW_UI,
        _G and _G.NA_UI_INSTANCE, _G and _G.NA_RAW_UI,
        shared and shared.NA_UI_INSTANCE, shared and shared.NA_RAW_UI
    }
    if type(env.NA_UI) == "function" then
        local ok, gui = pcall(env.NA_UI)
        if ok then table.insert(possible, gui) end
    end
    for _, gui in pairs(possible) do hideBackendGui(gui) end
    for gui in pairs(namelessOwnedGuis) do hideBackendGui(gui) end
    for _, root in ipairs(getAdminGuiRoots()) do
        for _, gui in ipairs(root:GetChildren()) do
            local name = string.lower(tostring(gui.Name))
            if gui:IsA("ScreenGui") and (
                name:find("nameless", 1, true) or name == "na" or
                name:find("na_ui", 1, true) or name:find("lollypopadminbackend", 1, true)
            ) then
                hideBackendGui(gui)
            end
        end
    end
end

local function makeNamelessSourceHeadless(source)
    source = tostring(source or "")
    -- Preserve Nameless command kode exactly; only force hidden startup and silence its own notifications.
    source = source:gsub("NALoadingStartMinimized%s*=%s*false", "NALoadingStartMinimized = true")
    source = source:gsub("NAHideStartup%s*=%s*false", "NAHideStartup = true")
    source = source:gsub(
        'NAHideStartup%s*=%s*NAmanage%.NASettingsGet%("hideStartup"%)%s*==%s*true',
        "NAHideStartup = true"
    )
    source = source:gsub(
        'NALoadingStartMinimized%s*=%s*NAmanage%.NASettingsGet%("loadingStartMinimized"%)',
        "NALoadingStartMinimized = true"
    )
    source = source:gsub(
        "Notify%s*=%s*NAStuff%.Notification%.Notify%s*\nWindow%s*=%s*NAStuff%.Notification%.Window%s*\nPopup%s*=%s*NAStuff%.Notification%.Popup",
        "Notify = function() end\nWindow = function() end\nPopup = function() end",
        1
    )
    return source
end

ensureNamelessBackend = function()
    local existing = findNamelessRunner and findNamelessRunner() or nil
    if existing then
        hideNamelessAdminUI()
        return true
    end
    if namelessLoading then
        local started = tick()
        repeat task.wait(0.1) until not namelessLoading or tick() - started > 30
        hideNamelessAdminUI()
        return findNamelessRunner and findNamelessRunner() ~= nil
    end

    namelessLoading = true
    LHCompat.SafeTableSet(env, "NAHideStartup", true)
    LHCompat.SafeTableSet(env, "NALoadingStartMinimized", true)
    LHCompat.SafeTableSet(env, "NA_MCP_OPTIONS", {
        allowUIAccess = false,
        commandPrediction = false,
        notifyCommands = false,
        notifyReads = false,
        notifyActivity = false,
        actor = "Lollypop Admin Kommands",
    })

    local known = setmetatable({}, {__mode = "k"})
    for _, root in ipairs(getAdminGuiRoots()) do
        for _, child in ipairs(root:GetChildren()) do
            if child:IsA("ScreenGui") then known[child] = true end
        end
    end

    local guards = {}
    for _, root in ipairs(getAdminGuiRoots()) do
        table.insert(guards, root.DescendantAdded:Connect(function(descendant)
            if descendant:IsA("ScreenGui") and not known[descendant] then
                hideBackendGui(descendant)
            elseif descendant:IsA("GuiObject") then
                local screen = descendant:FindFirstAncestorWhichIsA("ScreenGui")
                if screen and not known[screen] then hideBackendGui(screen) end
            end
        end))
    end

    local ok, err = pcall(function()
        local source = makeNamelessSourceHeadless(game:HttpGet(NAMELESS_ADMIN_URL, true))
        local compiled, compileError = loadstring(source)
        if not compiled then error(compileError or "Admin kommand backend failed to compile") end
        compiled()
        LHCompat.SafeTableSet(env, "DoNotif", function() end)
        LHCompat.SafeTableSet(env, "DoWindow", function() end)
        LHCompat.SafeTableSet(env, "DoPopup", function() end)
        local bridge = env.NA_MCP or env.NamelessAdminMCP
        if type(bridge) == "table" and type(bridge.options) == "function" then
            pcall(bridge.options, {
                allowUIAccess = false, commandPrediction = false,
                notifyCommands = false, notifyReads = false, notifyActivity = false,
                actor = "Lollypop Admin Kommands",
            })
        end
    end)

    for _, connection in ipairs(guards) do pcall(function() connection:Disconnect() end) end
    namelessLoading = false
    hideNamelessAdminUI()
    task.spawn(function()
        for _ = 1, 300 do
            task.wait(0.1)
            hideNamelessAdminUI()
        end
    end)

    if not ok then
        LHRuntime:Notify("error", "Admin Kommands", tostring(err), 3, nil, true)
        return false
    end
    -- The built-in Nameless kommand reference remains available without mutating Nameless's private tables.
    return findNamelessRunner and findNamelessRunner() ~= nil
end

findNamelessRunner = function()
    local candidates = {
        env.cmdRun, env.RunCommand, env.runCommand,
        env.NA_MCP and env.NA_MCP.run,
        env.NamelessAdminMCP and env.NamelessAdminMCP.run,
        _G and _G.cmdRun, _G and _G.RunCommand, _G and _G.runCommand
    }
    for _, fn in pairs(candidates) do
        if type(fn) == "function" then return fn end
    end
    return nil
end

for commandName, data in pairs(NamelessCommandReference) do
    if not LHRuntime.Commands[commandName] then
        local aliases, usage, description = data[1], data[2], data[3]
        LHRuntime:RegisterCommand(commandName, aliases, description, usage, function(args)
            local runner = findNamelessRunner()
            if not runner then
                ensureNamelessBackend()
                runner = findNamelessRunner()
            end
            if not runner then error("Nameless Admin backend could not be loaded.") end
            local commandText = commandName
            if #args > 0 then commandText = commandText .. " " .. table.concat(args, " ") end
            hideNamelessAdminUI()
            local ok, result = pcall(runner, commandText)
            hideNamelessAdminUI()
            if not ok then error(result) end
            if type(result) == "table" and result.ok == false then error(result.error or "Nameless command failed") end
            return result
        end)
    end
end

env.LHSyncNamelessKommands = function()
    local live = env.LHNamelessLiveCommands
    if type(live) ~= "table" or type(live.Commands) ~= "table" then return 0 end
    local aliasesByData = {}
    if type(live.Aliases) == "table" then
        for aliasName, data in pairs(live.Aliases) do
            if type(aliasName) == "string" and type(data) == "table" then
                aliasesByData[data] = aliasesByData[data] or {}
                table.insert(aliasesByData[data], string.lower(aliasName))
            end
        end
    end
    local added = 0
    for primaryName, data in pairs(live.Commands) do
        primaryName = string.lower(tostring(primaryName or ""))
        if primaryName ~= "" and type(data) == "table" and not LHRuntime.Commands[primaryName] then
            local info = type(data[2]) == "table" and data[2] or {}
            local aliases = aliasesByData[data] or {}
            local usage = tostring(info[1] or primaryName)
            local description = tostring(info[2] or "Nameless Admin kommand")
            LHRuntime:RegisterCommand(primaryName, aliases, description, usage, function(args)
                local runner = findNamelessRunner()
                if not runner then error("Nameless Admin backend is not ready.") end
                local commandText = primaryName
                if #args > 0 then commandText = commandText .. " " .. table.concat(args, " ") end
                hideNamelessAdminUI()
                local ok, result = pcall(runner, commandText)
                hideNamelessAdminUI()
                if not ok then error(result) end
                if type(result) == "table" and result.ok == false then error(result.error or "Nameless kommand failed") end
                return result
            end)
            added = added + 1
        end
    end
    return added
end

if not LHRuntime.Commands["un"] then
    LHRuntime:RegisterCommand("un", {"offcmd"}, "Turns off a supported admin kommand.", "un <kommand> [arguments]", function(args)
        local base = string.lower(tostring(args[1] or "")):gsub("^un", "")
        if base == "" then error("Usage: " .. LHRuntime.Prefix .. "un <kommand>") end
        table.remove(args, 1)
        local candidate = "un" .. base
        local command = LHRuntime.Commands[candidate]
        if not command then
            if not findNamelessRunner() then ensureNamelessBackend() end
            env.LHSyncNamelessKommands()
            command = LHRuntime.Commands[candidate]
        end
        if not command then error("No off kommand found for " .. base .. ".") end
        return command.Callback(args)
    end)
end

