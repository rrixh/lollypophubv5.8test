local function buildHub(window)
    if type(env.LHBuildUniversalIndex) == "function" then env.LHBuildUniversalIndex(tabOrder) end
    local requestedOrder = {
        ["Home"] = 1,
        ["Skripts"] = 2,
        ["Tools"] = 3,
        ["Admin"] = 4,
        ["Fun"] = 5,
        ["Hubs & GUIs"] = 6,
        [emoji.glowing_star.."Games"..emoji.glowing_star] = 7,
        ["FE"] = 8,
        ["Updates/Extras"] = 9,
        ["Server"] = 11,
        ["Debugging"] = 12,
        ["Ui Kustomization"] = 13,
        ["Bypasses & More"] = 14,
    }
    table.sort(tabOrder, function(a, b)
        local ai = requestedOrder[a._name] or 500
        local bi = requestedOrder[b._name] or 500
        if ai == bi then return tostring(a._name) < tostring(b._name) end
        return ai < bi
    end)
    for _, tabData in ipairs(tabOrder) do
        local realTab = window:NewTab(tabData._name)
        tabData._ui = realTab
        local function populateTab()
            local searchTabName = getSearchTabName(tabData._name)
            if searchTabs[searchTabName] and realTab.NewSearchBar then
                tabData._search = realTab:NewSearchBar({Placeholder = "Search " .. searchTabName .. "..."})
            end
            for _, sectionData in ipairs(tabData._sections) do
                local realSection = realTab:NewSection(sectionData._name, sectionData._hidden)
                sectionData._ui = realSection
                for _, item in ipairs(sectionData) do
                    local ui
                    local callback = item.callback
                    if item.kind == "button" and type(callback) == "function" then
                        local rawButtonCallback = callback
                        callback = function(...)
                            -- This button already displays its own final version result.
                            -- Skip the generic Running/Done island so only one message appears.
                            if item.displayName == "Check for LH Update" then
                                return rawButtonCallback(...)
                            end

                            -- Auto-close is a failsafe for loaders that yield, error, or never return.
                            local island = LHRuntime:ShowIsland(item.displayName, "Running...", {Duration = 4})
                            local results = table.pack(rawButtonCallback(...))
                            if island and island.Update then
                                island:Update(item.displayName, "Done.", 100)
                                task.delay(0.65, function() island:Close() end)
                            end
                            return table.unpack(results, 1, results.n)
                        end
                    end
                    local reversible = item.kind == "toggle" or item.kind == "textbox" or item.kind == "slider" or item.kind == "dropdown" or item.kind == "colorpicker" or item.kind == "counter"
                    if reversible and type(callback) == "function" then
                        if item._currentValue == nil then
                            if item.kind == "dropdown" then item._currentValue = item.default ~= nil and item.default or (item.options and item.options[1])
                            elseif item.kind == "toggle" then item._currentValue = item.default == true
                            else item._currentValue = item.default end
                        end
                        callback = function(value, ...)
                            local oldValue = item._currentValue
                            local results = table.pack(item.callback(value, ...))
                            if not item._suppressUndo and KAVO and type(KAVO.RecordUndo) == "function" and oldValue ~= value then
                                local previous = oldValue
                                KAVO:RecordUndo(item.id, item.displayName, oldValue, value, function()
                                    item._suppressUndo = true
                                    if item._ui and item._ui.SetValue then
                                        item._ui:SetValue(previous, true)
                                    else
                                        item.callback(previous)
                                    end
                                    item._currentValue = previous
                                    item._suppressUndo = false
                                end)
                            end
                            item._currentValue = value
                            return table.unpack(results, 1, results.n)
                        end
                    end
                    if item.kind == "button" then ui = realSection:NewButton(item.name,item.tip,callback)
                    elseif item.kind == "toggle" then ui = realSection:NewToggle(item.name,item.tip,callback,item.default)
                    elseif item.kind == "textbox" then ui = realSection:NewTextBox(item.name,item.tip,callback,item.placeholder,item.default)
                    elseif item.kind == "slider" then ui = realSection:NewSlider(item.name,item.tip,item.min,item.max,callback,item.default)
                    elseif item.kind == "dropdown" then ui = realSection:NewDropdown(item.name,item.tip,item.options,callback,item.default)
                    elseif item.kind == "keybind" then ui = realSection:NewKeybind(item.name,item.tip,item.key,callback)
                    elseif item.kind == "colorpicker" then ui = realSection:NewColorPicker(item.name,item.tip,item.default,callback)
                    elseif item.kind == "counter" and realSection.NewCounter then ui = realSection:NewCounter(item.name,item.tip,item.step,callback,item.default,item.min,item.max)
                    elseif item.kind == "label" then ui = realSection:NewLabel(item.text)
                    elseif item.kind == "banner" and realSection.NewBannerLabel then ui = realSection:NewBannerLabel(item.text)
                    elseif item.kind == "paragraph" and realSection.NewParagraph then ui = realSection:NewParagraph(item.title,item.text)
                    elseif item.kind == "kredits" and realSection.NewKreditsCard then ui = realSection:NewKreditsCard(item.config) end
                    item._ui = ui
                    if ui and ui.SetMetadata then
                        ui:SetMetadata({
                            ControlId = item.id,
                            DisplayName = item.displayName,
                            Kind = item.kind,
                            Tip = item.tip or item.text or "",
                            TabName = tabData._name,
                            SectionName = sectionData._name,
                        })
                    end
                    if item.resetDefault ~= nil and ui and ui.SetResetDefault then ui:SetResetDefault(item.resetDefault) end
                    if item.visible == false and ui and ui.SetVisible then ui:SetVisible(false) end
                end
            end
        end
        if realTab.SetLazyBuilder then realTab:SetLazyBuilder(populateTab) else populateTab() end
    end
end

local KAVO_URL = env.LH_KAVO_URL or "https://raw.githubusercontent.com/rrixh/uwuware/main/lib/kavomobile.lula"
local KAVO_SOURCE = env.LH_KAVO_SOURCE
local KAVO

local function compileAndRunKavo(source, chunkName)
    local compiler, compileError = loadstring(source, chunkName or "LH KAVO UI")
    if not compiler then return false, "compile error: " .. tostring(compileError) end
    local runOk, result = pcall(compiler)
    if not runOk then return false, "runtime error: " .. tostring(result) end
    if type(result) ~= "table" or type(result.CreateLib) ~= "function" then
        return false, "Kavo source did not return a valid UI library"
    end
    return true, result
end

local function loadKavoWithFallbacks()
    local failures = {}
    if type(KAVO_SOURCE) == "string" and KAVO_SOURCE ~= "" then
        local ok, result = compileAndRunKavo(KAVO_SOURCE, "LH KAVO UI [env source]")
        if ok then return result, "env.LH_KAVO_SOURCE" end
        table.insert(failures, "env source: " .. tostring(result))
    end

    if type(env.LHKavo) == "table" and type(env.LHKavo.CreateLib) == "function" then
        return env.LHKavo, "existing env.LHKavo"
    end

    local candidates = {
        KAVO_URL,
        "https://raw.githubusercontent.com/rrixh/uwuware/refs/heads/main/lib/kavomobile.lula",
    }
    local seen = {}
    for _, url in ipairs(candidates) do
        if type(url) == "string" and url ~= "" and not seen[url] then
            seen[url] = true
            local httpOk, sourceOrError = LHCompat.HttpGet(url, true)
            if httpOk then
                local runOk, result = compileAndRunKavo(sourceOrError, "LH KAVO UI [" .. url .. "]")
                if runOk then return result, url end
                table.insert(failures, url .. " -> " .. tostring(result))
            else
                table.insert(failures, url .. " -> " .. tostring(sourceOrError))
            end
        end
    end
    error("Kavo failed every startup branch: " .. table.concat(failures, " | "))
end

local kavoOk, kavoResult, kavoSource = xpcall(loadKavoWithFallbacks, function(message)
    return debug and debug.traceback and debug.traceback(tostring(message), 2) or tostring(message)
