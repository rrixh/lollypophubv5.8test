-- Capture the game's real JumpPower once, before LH movement kontrols change it.
if env.LHDefaultGameJumpPower == nil then
    pcall(function()
        local startupCharacter = lp.Character or lp.CharacterAdded:Wait()
        local startupHumanoid = startupCharacter and (startupCharacter:FindFirstChildOfClass("Humanoid") or startupCharacter:WaitForChild("Humanoid", 10))
