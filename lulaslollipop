local KrackheadWalk = {
    Enabled = false,
    RunningConnection = nil,
    CharacterConnection = nil,
    Spin = nil
}

local function disconnectKrackheadWalkConnection(name)
    local connection = KrackheadWalk[name]

    if connection then
        pcall(function()
            connection:Disconnect()
        end)

        KrackheadWalk[name] = nil
    end
end

local function removeKrackheadSpin()
    if KrackheadWalk.Spin then
        pcall(function()
            KrackheadWalk.Spin:Destroy()
        end)

        KrackheadWalk.Spin = nil
    end

    local character = get.Players.LocalPlayer.Character
    local rootPart = character
        and character:FindFirstChild("HumanoidRootPart")

    if rootPart then
        for _, object in ipairs(rootPart:GetChildren()) do
            if object.Name == "Spinning" then
                object:Destroy()
            end
        end
    end
end

local function disableKrackheadWalk()
    KrackheadWalk.Enabled = false

    disconnectKrackheadWalkConnection("RunningConnection")
    disconnectKrackheadWalkConnection("CharacterConnection")

    removeKrackheadSpin()
end

local function setupKrackheadWalk(character)
    disconnectKrackheadWalkConnection("RunningConnection")
    removeKrackheadSpin()

    if not KrackheadWalk.Enabled then
        return
    end

    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")

    KrackheadWalk.RunningConnection =
        humanoid.Running:Connect(function(speed)
            if not KrackheadWalk.Enabled then
                removeKrackheadSpin()
                return
            end

            if speed > 0 then
                if not KrackheadWalk.Spin
                    or not KrackheadWalk.Spin.Parent then

                    local spin = Instance.new("BodyAngularVelocity")
                    spin.Name = "Spinning"
                    spin.MaxTorque = Vector3.new(
                        math.huge,
                        math.huge,
                        math.huge
                    )
                    spin.AngularVelocity = Vector3.new(0, 10, 0)
                    spin.Parent = rootPart

                    KrackheadWalk.Spin = spin
                end
            else
                removeKrackheadSpin()
            end
        end)
end

add(FunSection, toggle("Krackhead walk", "spin walking", function(enabled)
        if enabled then
            disableKrackheadWalk()
            KrackheadWalk.Enabled = true;
            local player = get.Players.LocalPlayer
            local character = player.Character
                or player.CharacterAdded:Wait()

            setupKrackheadWalk(character)

            KrackheadWalk.CharacterConnection =
                player.CharacterAdded:Connect(function(newCharacter)
                    if KrackheadWalk.Enabled then
                        setupKrackheadWalk(newCharacter)
                    end
                end)
        else
            disableKrackheadWalk()
        end;
end))

local JumpFlip = {
    Enabled = false,
    Token = 0,
    JumpConnection = nil,
    CharacterConnection = nil,
    Humanoid = nil,
    Sound = nil,
    Spins = {},
    OriginalGravity = nil,
    FallingDownEnabled = true,
    RagdollEnabled = true
}

local function disconnectJumpFlipConnection(connectionName)
    local connection = JumpFlip[connectionName]

    if connection then
        pcall(function()
            connection:Disconnect()
        end)

        JumpFlip[connectionName] = nil
    end
end

local function destroySpin(spin)
    if spin then
        JumpFlip.Spins[spin] = nil

        pcall(function()
            spin:Destroy()
        end)
    end
end

local function destroyAllJumpFlipSpins()
    for spin in pairs(JumpFlip.Spins) do
        destroySpin(spin)
    end

    table.clear(JumpFlip.Spins)
end

local function restoreJumpFlipHumanoid()
    local humanoid = JumpFlip.Humanoid

    if humanoid and humanoid.Parent then
        pcall(function()
            humanoid:SetStateEnabled(
                Enum.HumanoidStateType.FallingDown,
                JumpFlip.FallingDownEnabled
            )

            humanoid:SetStateEnabled(
                Enum.HumanoidStateType.Ragdoll,
                JumpFlip.RagdollEnabled
            )
        end)
    end

    JumpFlip.Humanoid = nil
end

local function clearJumpFlipCharacter()
    JumpFlip.Token = JumpFlip.Token + 1

    disconnectJumpFlipConnection("JumpConnection")
    destroyAllJumpFlipSpins()
    restoreJumpFlipHumanoid()

    if JumpFlip.Sound then
        pcall(function()
            JumpFlip.Sound:Stop()
            JumpFlip.Sound:Destroy()
        end)

        JumpFlip.Sound = nil
    end

    if JumpFlip.OriginalGravity then
        get.Workspace.Gravity = JumpFlip.OriginalGravity
    end
end

local function disableJumpFlip()
    JumpFlip.Enabled = false
    JumpFlip.Token = JumpFlip.Token + 1

    disconnectJumpFlipConnection("JumpConnection")
    disconnectJumpFlipConnection("CharacterConnection")

    destroyAllJumpFlipSpins()

    if JumpFlip.Sound then
        pcall(function()
            JumpFlip.Sound:Stop()
            JumpFlip.Sound:Destroy()
        end)

        JumpFlip.Sound = nil
    end

    if JumpFlip.OriginalGravity then
        get.Workspace.Gravity = JumpFlip.OriginalGravity
    end

    restoreJumpFlipHumanoid()
end

local function setupJumpFlip(character)
    clearJumpFlipCharacter()

    if not JumpFlip.Enabled then
        return
    end

    local humanoid = character:WaitForChild("Humanoid")
    local head = character:WaitForChild("Head")

    JumpFlip.Humanoid = humanoid

    JumpFlip.FallingDownEnabled = humanoid:GetStateEnabled(
        Enum.HumanoidStateType.FallingDown
    )

    JumpFlip.RagdollEnabled = humanoid:GetStateEnabled(
        Enum.HumanoidStateType.Ragdoll
    )

    humanoid:SetStateEnabled(
        Enum.HumanoidStateType.FallingDown,
        false
    )

    humanoid:SetStateEnabled(
        Enum.HumanoidStateType.Ragdoll,
        false
    )

    local sound = Instance.new("Sound")
    sound.Name = "JumpFlipSound"
    sound.SoundId = "rbxassetid://4911756917"
    sound.Volume = 5
    sound.Looped = false
    sound.Archivable = false
    sound.Parent = get.Workspace

    JumpFlip.Sound = sound

    JumpFlip.JumpConnection = humanoid
        :GetPropertyChangedSignal("Jump")
        :Connect(function()
            if not JumpFlip.Enabled or not humanoid.Jump then
                return
            end

            local flipToken = JumpFlip.Token

            task.spawn(function()
                if not JumpFlip.Enabled
                    or flipToken ~= JumpFlip.Token
                    or not head.Parent then
                    return
                end

                if JumpFlip.Sound then
                    pcall(function()
                        JumpFlip.Sound.TimePosition = 0.6
                        JumpFlip.Sound:Play()
                    end)
                end

                local spin = Instance.new("BodyAngularVelocity")
                spin.Name = "flipping"
                spin.MaxTorque = Vector3.new(
                    math.huge,
                    math.huge,
                    math.huge
                )
                spin.AngularVelocity = Vector3.new(10, 0, 0)
                spin.Parent = head

                JumpFlip.Spins[spin] = true

                task.wait(0.5)

                if not JumpFlip.Enabled
                    or flipToken ~= JumpFlip.Token then
                    destroySpin(spin)
                    return
                end

                get.Workspace.Gravity = 1000
                task.wait()

                if JumpFlip.OriginalGravity then
                    get.Workspace.Gravity = JumpFlip.OriginalGravity
                end

                destroySpin(spin)
            end)
        end)
end

add(FunSection, toggle("Jump to flip", "changes your jump to a flip", function(enabled)
