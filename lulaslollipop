function LHRuntime:SaveGameConfig(name)
    if not ensureConfigFolder() then return false, "file functions unavailable" end
    name = safeConfigName(name)
    local path = LH_SETTINGS_FOLDER .. "/configs/" .. name .. ".json"
    local payload = {
        Version = Vv,
        PlaceId = game.PlaceId,
        SavedAt = os.time(),
        Settings = env.LHSettings,
    }
    local ok, err = pcall(function() writefile(path, HttpService:JSONEncode(payload)) end)
    return ok, err, name
end

function LHRuntime:LoadGameConfig(name)
    name = safeConfigName(name)
    local path = LH_SETTINGS_FOLDER .. "/configs/" .. name .. ".json"
    if not (isfile and readfile and isfile(path)) then return false, "config not found" end
    local ok, payload = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(payload) ~= "table" then return false, tostring(payload) end
    mergeSettings(env.LHSettings, payload.Settings or payload)
    self.Prefix = tostring(env.LHSettings.CommandPrefix or "!")
    self:ApplySettings()
    self:SaveSettings()
    return true, name
end

function LHRuntime:DeleteGameConfig(name)
    name = safeConfigName(name)
    local path = LH_SETTINGS_FOLDER .. "/configs/" .. name .. ".json"
    if not (isfile and delfile and isfile(path)) then return false, "config not found or delfile unavailable" end
    local ok, err = pcall(function() delfile(path) end)
    return ok, err
end

function LHRuntime:RenameGameConfig(oldName, newName)
    oldName, newName = safeConfigName(oldName), safeConfigName(newName)
    local folder = LH_SETTINGS_FOLDER .. "/configs/"
    local oldPath, newPath = folder .. oldName .. ".json", folder .. newName .. ".json"
    if not (isfile and readfile and writefile and delfile and isfile(oldPath)) then return false, "rename unavailable or old config missing" end
    local ok, err = pcall(function()
        writefile(newPath, readfile(oldPath))
        delfile(oldPath)
    end)
    return ok, err
end

function LHRuntime:ListConfigs()
    local names = {}
    if not (listfiles and ensureConfigFolder()) then return names end
    local ok, files = pcall(function() return listfiles(LH_SETTINGS_FOLDER .. "/configs") end)
    if not ok or type(files) ~= "table" then return names end
    for _, path in ipairs(files) do
        local name = tostring(path):match("([^/\\]+)%.json$")
        if name then table.insert(names, name) end
    end
    table.sort(names)
    return names
end

