add(GamesSection, toggle("SHOW PATH", "marks the korrect path", function(x)
    env.LHMemoryBridgeReveal = x == true
    env.LHMemoryBridgeRevision = (tonumber(env.LHMemoryBridgeRevision) or 0) + 1
    local revision = env.LHMemoryBridgeRevision

    if not env.LHMemoryBridgeReveal then
        print("revealing path:", false)
        return
    end

    task.spawn(function()
        while env.LHMemoryBridgeReveal == true
            and env.LHMemoryBridgeRevision == revision do

            local workspace = cloneref(game:GetService("Workspace"))
            local glassTiles = workspace:FindFirstChild("GlassTiles")
            if not glassTiles then
                env.LHMemoryBridgeReveal = false
                break
            end

            for _, tileFolder in ipairs(glassTiles:GetChildren()) do
                for i = 1, 3 do
                    local tile = tileFolder:FindFirstChild("Tile" .. i)
                    if tile and tile:IsA("BasePart") then
                        tile.BrickColor = tile.CanCollide
                            and BrickColor.new("Lime green")
                            or BrickColor.new("Really red")
                    end
                end
            end

            task.wait(.77)
        end
        print("revealing path:", env.LHMemoryBridgeReveal == true)
    end)
end))

