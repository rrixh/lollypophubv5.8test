function LHCompat.WriteJsonAtomic(path, value, backupPath)
    if not LHCompat.Native.WriteFile then return false, "writefile unavailable" end
    LHCompat.EnsureFolder(LH_SETTINGS_FOLDER)
    local encodedOk, encoded = pcall(function() return HttpService:JSONEncode(value) end)
    if not encodedOk then return false, encoded end

    if backupPath then
        local oldOk, oldText = LHCompat.ReadText(path)
        if oldOk and type(oldText) == "string" then pcall(LHCompat.Native.WriteFile, backupPath, oldText) end
    end

    local tempPath = path .. ".tmp"
    local tempOk, tempErr = pcall(LHCompat.Native.WriteFile, tempPath, encoded)
    if not tempOk then return false, tempErr end
    local verifyOk, verifyText = LHCompat.ReadText(tempPath)
    if not verifyOk or verifyText ~= encoded then return false, "temporary save verification failed" end
    local writeOk, writeErr = pcall(LHCompat.Native.WriteFile, path, encoded)
    if LHCompat.Native.DeleteFile then pcall(LHCompat.Native.DeleteFile, tempPath) end
    return writeOk, writeErr
end

