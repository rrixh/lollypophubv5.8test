                local toggleSize = math.clamp(tonumber(toggleButtonSize) or 47, 28, 160)
                local toggleX = math.max(0, areaSize.X - toggleSize - 94)
                x = toggleX + ((toggleSize - desiredSize) * 0.5)
                y = 17 + toggleSize + gap
            end
            mobileOpen.Position = UDim2.fromOffset(x, y)
            clampMobileOpen()
        end

