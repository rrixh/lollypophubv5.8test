            caption.Font = Enum.Font.GothamBold
            caption.Text = actionName
            caption.TextColor3 = Color3.fromRGB(238, 232, 242)
            caption.TextScaled = true
            caption.TextWrapped = true
            caption.ZIndex = 23
            caption.Parent = button

            button.Activated:Connect(function()
                if ringOverlay ~= overlay or not ringOpen then return end
                closeRing(false)
                task.delay(0.20, function()
                    LHRuntime:Safe("Quick Action " .. actionName, performQuickAction, actionName)
                end)
            end)
        end

        animateRing(overlay, true)
    end

    LHRuntime:AddCleanup(function()
        ringSerial = ringSerial + 1
        stopRingAnimation()
        if ringOverlay and ringOverlay.Parent then
            pcall(function() ringOverlay:Destroy() end)
        end
        ringOverlay = nil
        ringOpen = false
    end)

    env.LHOpenQuickActions = openRing
    env.LHCloseQuickActions = closeRing

    local dragging, dragInput, mousePos, framePos, moved = false, nil, nil, nil, false
    local threshold = 6
    local holdToken = 0
    local heldOpen = false

    local function clampLollypopToggle()
        if not roundButton or not roundButton.Parent or not toggleSafeArea or not toggleSafeArea.Parent then return end
        local areaSize = toggleSafeArea.AbsoluteSize
        local buttonSize = roundButton.AbsoluteSize
        if areaSize.X <= 0 or areaSize.Y <= 0 or buttonSize.X <= 0 or buttonSize.Y <= 0 then return end

        local x = math.clamp(roundButton.Position.X.Offset, 0, math.max(0, areaSize.X - buttonSize.X))
        local y = math.clamp(roundButton.Position.Y.Offset, 0, math.max(0, areaSize.Y - buttonSize.Y))
        roundButton.Position = UDim2.fromOffset(x, y)
        if type(env.LHPlaceAdminButton) == "function" then
            task.defer(env.LHPlaceAdminButton)
        end
    end

    local function finishToggleDrag(shouldClamp)
        dragging = false
        dragInput = nil
        mousePos = nil
        framePos = nil
        setToggleDragGlow(false)
        holdToken = holdToken + 1
        if shouldClamp ~= false then
            task.defer(clampLollypopToggle)
        end
    end

    env.LHCancelToggleDrag = function()
        finishToggleDrag(false)
    end
    env.LHClampToggleButton = clampLollypopToggle

    LHRuntime:Track(roundButton.InputBegan:Connect(function(inputObject)
        if inputObject.UserInputType ~= Enum.UserInputType.MouseButton1
            and inputObject.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        moved = false
        heldOpen = false
        holdToken = holdToken + 1
        local mine = holdToken

        if not env.LHSettings.ToggleDragLocked then
            mousePos = Vector2.new(inputObject.Position.X, inputObject.Position.Y)
            framePos = roundButton.Position
            dragInput = inputObject
            dragging = true
            setToggleDragGlow(true)

            LHRuntime:Track(inputObject:GetPropertyChangedSignal("UserInputState"):Connect(function()
                if dragInput ~= inputObject then return end
                if inputObject.UserInputState == Enum.UserInputState.End
                    or inputObject.UserInputState == Enum.UserInputState.Cancel then
                    finishToggleDrag(true)
                end
            end))
        end

        task.delay(0.5, function()
            if holdToken == mine and not moved and roundButton.Parent and not ringOpen then
                heldOpen = true
                if dragging then finishToggleDrag(false) end
                openRing()
            end
        end)
    end))

    LHRuntime:Track(get.RunService.RenderStepped:Connect(function()
        if not dragging or not dragInput then return end
        if env.LHSettings.ToggleDragLocked then
            finishToggleDrag(false)
            return
        end
        if dragInput.UserInputState == Enum.UserInputState.End
            or dragInput.UserInputState == Enum.UserInputState.Cancel then
            finishToggleDrag(true)
            return
        end

        local current = Vector2.new(dragInput.Position.X, dragInput.Position.Y)
        local delta = current - mousePos
        if math.abs(delta.X) > threshold or math.abs(delta.Y) > threshold then
            moved = true
            holdToken = holdToken + 1
            roundButton.Position = UDim2.fromOffset(
                framePos.X.Offset + delta.X,
                framePos.Y.Offset + delta.Y
            )
            clampLollypopToggle()
        end
    end))

    LHRuntime:Track(toggleSafeArea:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        task.defer(clampLollypopToggle)
    end))
    task.defer(clampLollypopToggle)
    LHRuntime:Track(roundButton.MouseButton1Click:Connect(function()
        if heldOpen then
            heldOpen = false
            return
        end
        if moved then
            moved = false
            return
        end
        if ringOpen then
            closeRing()
            return
        end
        KAVO:ToggleUI()
    end))
end
