        center.TextScaled = true
        center.Font = Enum.Font.GothamBold
        center.ZIndex = 23
        center.Active = false
        center.Parent = overlay
        Instance.new("UICorner", center).CornerRadius = UDim.new(1, 0)
        local centerStroke = Instance.new("UIStroke", center)
