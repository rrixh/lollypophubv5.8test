env.LHSendXhat = function(message)
    message = tostring(message or ""):match("^%s*(.-)%s*$")
    if message == "" then return false end
    local textChatService = get.TextChatService
    local inputConfig = textChatService and textChatService.ChatInputBarConfiguration
    local target = inputConfig and inputConfig.TargetTextChannel
    if not target and textChatService then
        local channels = textChatService:FindFirstChild("TextChannels")
        target = channels and (channels:FindFirstChild("RBXGeneral") or channels:FindFirstChildWhichIsA("TextChannel"))
    end
    if not target or not target:IsA("TextChannel") then
        LHRuntime:Notify("warning", "Chat", "No available chat channel was found.", 3)
        return false
    end
    local ok = pcall(function() target:SendAsync(message) end)
    if not ok then
        LHRuntime:Notify("error", "Chat", "Message kould not be sent.", 3)
        return false
    end
    if env.LHXhatKontrol and env.LHXhatKontrol.SetValue then
        env.LHXhatKontrol:SetValue("", false)
    end
    return true
end

