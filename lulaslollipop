-- Integrated universal Hitbox Expander. It never edits/destroys LH's ESP Highlight.
env.LHHitboxExpander = env.LHHitboxExpander or {
    Enabled = false, Size = 6, Invisible = false, Shape = "Kube", Originals = {}, Proxies = {}
}
function env.LHHitboxExpander:RestorePlayer(player)
    local original = self.Originals[player]
    local character = player and player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root and original then
        pcall(function() root.Size = original.Size end)
        pcall(function() root.Transparency = original.Transparency end)
        pcall(function() if root:IsA("Part") then root.Shape = original.Shape or Enum.PartType.Block end end)
        pcall(function() root.CanCollide = original.CanCollide end)
        pcall(function() root.CanTouch = original.CanTouch end)
        pcall(function() root.CanQuery = original.CanQuery end)
    end
    self.Originals[player] = nil
    local proxy = self.Proxies[player]
    if proxy then pcall(function() proxy:Destroy() end) end
    self.Proxies[player] = nil
end
function env.LHHitboxExpander:ApplyPlayer(player)
    if not self.Enabled or not player or player == get.Players.LocalPlayer then return end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then return end
    if not self.Originals[player] then
        self.Originals[player] = {
            Size = root.Size, Transparency = root.Transparency,
            Shape = root:IsA("Part") and root.Shape or nil,
            CanCollide = root.CanCollide, CanTouch = root.CanTouch, CanQuery = root.CanQuery
        }
    end
    local amount = math.clamp(tonumber(self.Size) or 6, 1, 50)
    local shape = tostring(self.Shape or "Kube")
    local transparency = self.Invisible and 1 or 0.72
    if shape == "Triangle" then
        -- Wedge proxy keeps the requested triangle shape without replacing the real HRP.
        pcall(function() root.Size = self.Originals[player].Size end)
        pcall(function() root.Transparency = self.Originals[player].Transparency end)
        if not self.Proxies[player] or not self.Proxies[player].Parent then
            local wedge = Instance.new("WedgePart")
            wedge.Name = "LHHitboxTriangle"
            wedge.Anchored = true
            wedge.CanCollide = false
            wedge.CanTouch = true
            wedge.CanQuery = true
            wedge.Massless = true
            wedge.Material = Enum.Material.ForceField
            wedge.Color = Color3.fromRGB(255, 72, 92)
            wedge:SetAttribute("LHHitboxTargetUserId", player.UserId)
            wedge.Parent = character
            self.Proxies[player] = wedge
        end
        local wedge = self.Proxies[player]
        wedge.Size = Vector3.new(amount, amount, amount)
        wedge.CFrame = root.CFrame
        wedge.Transparency = transparency
    else
        local proxy = self.Proxies[player]
        if proxy then pcall(function() proxy:Destroy() end); self.Proxies[player] = nil end
        pcall(function()
            root.Size = Vector3.new(amount, amount, amount)
            root.Transparency = transparency
            root.CanCollide = false
            root.CanTouch = true
            root.CanQuery = true
