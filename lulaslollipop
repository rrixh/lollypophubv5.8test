function env.LHHitboxExpander:Refresh()
    if not self.Enabled then return end
    for _, player in ipairs(get.Players:GetPlayers()) do
        if player ~= get.Players.LocalPlayer then self:ApplyPlayer(player) end
    end
    for player, proxy in pairs(self.Proxies) do
        if not player.Parent or not player.Character then
            self:RestorePlayer(player)
        elseif proxy and proxy.Parent then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root then proxy.CFrame = root.CFrame end
        end
    end
end
function env.LHHitboxExpander:SetEnabled(value)
    self.Enabled = value == true
    if self.Enabled then self:Refresh() else
        for player in pairs(self.Originals) do self:RestorePlayer(player) end
    end
end
