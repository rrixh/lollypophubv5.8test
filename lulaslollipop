env.LHGameButton = function(label, description, callback)
    return button(label, description, function(...)
        local packedArgs = table.pack(...)
        local ok, result = pcall(function()
            return callback(table.unpack(packedArgs, 1, packedArgs.n))
        end)

        if ok then
            return result
        end

        local err = tostring(result or "Unknown game skript error")
        local lowered = string.lower(err)
        local missing = err:match("([%w_]+)%s+is not a valid member of Workspace")

        warn("[Lollypop Hub Game Guard] " .. err)

        if missing
            or (lowered:find("workspace", 1, true) and lowered:find("not a valid member", 1, true))
            or (lowered:find("workspace", 1, true) and lowered:find("not found", 1, true)) then

            local itemText = missing and ('"' .. tostring(missing) .. '"') or "A required Workspace item"
            LHRuntime:Notify(
                "warning",
                "Game Item Not Found",
                itemText .. " wasn't found. You may not be in the right game, or the game may have changed.",
                6,
                nil,
                true
            )
            return
        end

        if lowered:find("attempt to index nil", 1, true)
            or lowered:find("attempt to index missing", 1, true)
            or lowered:find("infinite yield possible", 1, true) then

            LHRuntime:Notify(
                "warning",
                "Game Skript Stopped",
                "A required game object wasn't available. You may be in the wrong game or the game changed.",
                6,
                nil,
                true
            )
            return
        end

        LHRuntime:Notify(
            "warning",
            "Game Skript Stopped",
            "This game skript couldn't run here. Check that you're in the correct experience.",
            6,
            nil,
            true
        )
    end)
end

