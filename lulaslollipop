    end
    for numberText in tostring(rightVersion or ""):gmatch("%d+") do
        rightParts[#rightParts + 1] = tonumber(numberText) or 0
    end

    for index = 1, math.max(#leftParts, #rightParts) do
        local leftNumber = leftParts[index] or 0
        local rightNumber = rightParts[index] or 0
        if leftNumber > rightNumber then return 1 end
        if leftNumber < rightNumber then return -1 end
    end
    return 0
end


env.LHCollectWhatsNew = function(previousVersion)
    previousVersion = env.LHNormalizeVersion(previousVersion) or "0.0.0"
    local currentVersion = env.LHNormalizeVersion(Vv) or tostring(Vv)
    local collected = {}
    for version, entries in pairs(type(WatsNew) == "table" and WatsNew or {}) do
        local normalized = env.LHNormalizeVersion(version)
        if normalized
            and env.LHCompareVersions(normalized, previousVersion) > 0
            and env.LHCompareVersions(normalized, currentVersion) <= 0
            and type(entries) == "table" then
            for _, text in ipairs(entries) do
                collected[#collected + 1] = {Version = normalized, Text = tostring(text)}
            end
        end
    end
    table.sort(collected, function(a, b)
        local compared = env.LHCompareVersions(a.Version, b.Version)
        if compared == 0 then return tostring(a.Text) < tostring(b.Text) end
        return compared < 0
    end)
    return collected
end

env.LHMarkWhatsNewSeen = function()
    env.LHSettings.WhatsNewSeenVersion = Vv
    env.LHSettings.LastUsedVersion = Vv
    LHRuntime:SaveSettings()
end

env.LHShowWhatsNew = function(force)
    local previous = env.LHSettings.LastUsedVersion or env.LHSettings.WhatsNewSeenVersion
    local seen = env.LHNormalizeVersion(env.LHSettings.WhatsNewSeenVersion)
    local current = env.LHNormalizeVersion(Vv)

    if not previous and LH_HAD_EXISTING_SETTINGS then previous = "10.4.1" end
    if force and previous and current and env.LHCompareVersions(previous, current) >= 0 then previous = "10.4.1" end

    if not force then
        if not previous then env.LHMarkWhatsNewSeen(); return false end
        if seen and current and env.LHCompareVersions(seen, current) >= 0 then
            env.LHSettings.LastUsedVersion = Vv
            LHRuntime:SaveSettings()
            return false
        end
        local previousNormalized = env.LHNormalizeVersion(previous)
