local function showSessionRestorePrompt(previousSession)
    local parent = LHCompat.GetHui()
    local old = parent:FindFirstChild("LHSessionRestorePrompt")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "LHSessionRestorePrompt"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 1000002
    local parented = LHCompat.ParentGui(gui)
    if not parented then
        startCurrentSession()
        return
    end

    local shade = Instance.new("TextButton")
    shade.Size = UDim2.fromScale(1, 1)
    shade.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    shade.BackgroundTransparency = 0.42
    shade.BorderSizePixel = 0
    shade.Text = ""
    shade.AutoButtonColor = false
    shade.Parent = gui

    local card = Instance.new("Frame")
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.Position = UDim2.fromScale(0.5, 0.5)
    card.Size = UDim2.fromOffset(390, 215)
    card.BackgroundColor3 = Color3.fromRGB(16, 12, 22)
    card.BorderSizePixel = 0
    card.Parent = gui
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 14)
    local stroke = Instance.new("UIStroke", card)
    stroke.Color = getgenv().LollypopTheme
    stroke.Transparency = 0.12
    stroke.Thickness = 1.2
    local scale = Instance.new("UIScale", card)
    local view = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
    scale.Scale = math.max(0.72, math.min(1, (view.X - 24) / 410, (view.Y - 46) / 235))

    local title = Instance.new("TextLabel")
    title.Position = UDim2.fromOffset(18, 16)
    title.Size = UDim2.new(1, -36, 0, 34)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBold
    title.TextSize = 19
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.Text = "Restore previous session?"
    title.Parent = card

    local body = Instance.new("TextLabel")
    body.Position = UDim2.fromOffset(18, 54)
    body.Size = UDim2.new(1, -36, 0, 92)
    body.BackgroundTransparency = 1
    body.Font = Enum.Font.GothamMedium
    body.TextSize = 13
    body.TextColor3 = Color3.fromRGB(218, 210, 225)
    body.TextWrapped = true
    body.TextYAlignment = Enum.TextYAlignment.Top
    local previousTab = previousSession.State and previousSession.State.SelectedTab or "your last page"
    body.Text = "LH detected that Roblox or your executor klosed unexpectedly. Press Yes to return to " .. tostring(previousTab) .. " with the saved scroll position and navigation state. Press No to load normally with your kurrent saved settings."
    body.Parent = card

    local yes = Instance.new("TextButton")
    yes.Position = UDim2.new(0, 18, 1, -52)
    yes.Size = UDim2.new(0.5, -24, 0, 36)
    yes.BackgroundColor3 = Color3.fromRGB(40, 185, 92)
    yes.BorderSizePixel = 0
    yes.Font = Enum.Font.GothamBold
    yes.TextSize = 14
    yes.TextColor3 = Color3.fromRGB(255, 255, 255)
    yes.Text = "Yes, Restore"
    yes.Parent = card
    Instance.new("UICorner", yes).CornerRadius = UDim.new(0, 9)
    LHRuntime:AddButtonPressEffect(yes)

    local no = Instance.new("TextButton")
    no.Position = UDim2.new(0.5, 6, 1, -52)
    no.Size = UDim2.new(0.5, -24, 0, 36)
    no.BackgroundColor3 = Color3.fromRGB(72, 63, 83)
    no.BorderSizePixel = 0
    no.Font = Enum.Font.GothamBold
    no.TextSize = 14
    no.TextColor3 = Color3.fromRGB(255, 255, 255)
    no.Text = "No, Load Normal"
    no.Parent = card
    Instance.new("UICorner", no).CornerRadius = UDim.new(0, 9)
    LHRuntime:AddButtonPressEffect(no)

    local answered = false
    local function finish(restore)
        if answered then return end
        answered = true
        if gui.Parent then gui:Destroy() end
        if restore and type(previousSession.State) == "table" and Window.RestoreUIState then
            local ok, err = Window:RestoreUIState(previousSession.State)
            if ok then
                LHRuntime:ShowIsland("Session Restored", "Returned to your previous LH position.", {Duration = 3})
task.wait()
lhsay(emoji.warning.." Roblox Banwave",  "There is an active banwave going on so i will be inactive until its over", 11)
            else
                LHRuntime:Notify("error", "Session Restore", tostring(err), 5, nil, true)
                Window:SelectTab("Home")
            end
        else
            Window:SelectTab("Home")
            LHRuntime:ShowIsland("Normal Start", "Saved settings loaded without the old session position.", {Duration = 2.6})
task.wait()
lhsay(emoji.warning.." Roblox Banwave",  "There is an active banwave going on so i will be inactive until its over", 11)
        end
        task.defer(startCurrentSession)
    end

    LHRuntime:Track(yes.MouseButton1Click:Connect(function() finish(true) end))
    LHRuntime:Track(no.MouseButton1Click:Connect(function() finish(false) end))
end

local previousIsCrash = env.LHSettings.SessionRestore ~= false
    and type(LH_PREVIOUS_SESSION) == "table"
    and LH_PREVIOUS_SESSION.Running == true
    and LH_PREVIOUS_SESSION.CleanShutdown ~= true
    and type(LH_PREVIOUS_SESSION.State) == "table"
    and (os.time() - (tonumber(LH_PREVIOUS_SESSION.SavedAt) or os.time())) <= (7 * 24 * 60 * 60)

if previousIsCrash then
    showSessionRestorePrompt(LH_PREVIOUS_SESSION)
else
    startCurrentSession()
end

