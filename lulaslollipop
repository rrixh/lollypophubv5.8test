function LHCompat.SafeTableSet(tbl, key, value)
    if type(tbl) ~= "table" then return false, "target is not a table" end

    local directOk, directErr = pcall(function()
        tbl[key] = value
    end)
    if directOk then return true end

    local changed = false
    local restoreReadonly = false

    if LHCompat.Native.IsReadonly then
        local okState, state = pcall(LHCompat.Native.IsReadonly, tbl)
        if okState then restoreReadonly = state == true end
    end

    if LHCompat.Native.SetReadonly then
        local okUnlock = pcall(LHCompat.Native.SetReadonly, tbl, false)
        changed = okUnlock == true
    elseif LHCompat.Native.MakeWritable then
        local okUnlock = pcall(LHCompat.Native.MakeWritable, tbl)
        changed = okUnlock == true
        restoreReadonly = changed
    end

    if not changed then
        return false, directErr
    end

    local writeOk, writeErr = pcall(function()
        tbl[key] = value
    end)

    if LHCompat.Native.SetReadonly then
        pcall(LHCompat.Native.SetReadonly, tbl, restoreReadonly)
    elseif restoreReadonly and LHCompat.Native.MakeReadonly then
        pcall(LHCompat.Native.MakeReadonly, tbl)
    end

    return writeOk, writeErr
end

