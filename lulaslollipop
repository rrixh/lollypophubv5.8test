            if env.LHDefaultGameJumpHeight == nil then
                env.LHDefaultGameJumpHeight = tonumber(startupHumanoid.JumpHeight) or 7.2
            end
        end
    end)
end
if env.LHDefaultGameJumpPower == nil then env.LHDefaultGameJumpPower = 50 end
if env.LHDefaultGameJumpHeight == nil then env.LHDefaultGameJumpHeight = 7.2 end

local LHFeatures = {
    Character = nil,
    Humanoid = nil,
    Root = nil,
    CharacterDiedConnection = nil,
    Dead = false,
    NoClipEnabled = false,
    InfiniteJumpEnabled = false,
    AntiSitEnabled = false,
    JumpLimitBypassEnabled = false,
    ProximityAutoJumpEnabled = false,
    ProximityDistance = 7.5,
    ProximityTargetUserId = 0,
    ProximityAccumulator = 0,
    LastProximityJump = 0,
    UniversalJumpPower = tonumber(env.LHSettings.UniversalJumpPower) or 50,
    NoClipOriginal = setmetatable({}, {__mode = "k"}),
    JumpModeOriginal = setmetatable({}, {__mode = "k"}),
    JumpLimitTargets = setmetatable({}, {__mode = "k"}),
}
env.LHFeatures = LHFeatures

function LHFeatures:GetHumanoid()
    if self.Humanoid and self.Humanoid.Parent then return self.Humanoid end
    local character = lp.Character
    self.Humanoid = character and character:FindFirstChildOfClass("Humanoid") or nil
    return self.Humanoid
end

function LHFeatures:GetRoot()
    if self.Root and self.Root.Parent then return self.Root end
    local character = lp.Character
    self.Root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")) or nil
    return self.Root
end

function LHFeatures:CaptureJumpLimitValues(humanoid)
    humanoid = humanoid or self:GetHumanoid()
    if not humanoid or not humanoid.Parent then return nil end

    local target = {Humanoid = humanoid}
    local okMode, useJumpPower = pcall(function() return humanoid.UseJumpPower end)
    if okMode then
        target.HasUseJumpPower = true
        target.UseJumpPower = useJumpPower == true
    end

    local okPower, jumpPower = pcall(function() return humanoid.JumpPower end)
    if okPower and type(jumpPower) == "number" then
        target.HasJumpPower = true
        target.JumpPower = jumpPower
        self.UniversalJumpPower = jumpPower
        env.LHSettings.UniversalJumpPower = jumpPower
    end

    local okHeight, jumpHeight = pcall(function() return humanoid.JumpHeight end)
    if okHeight and type(jumpHeight) == "number" then
        target.HasJumpHeight = true
        target.JumpHeight = jumpHeight
    end

    self.JumpLimitTargets[humanoid] = target
    return target
end

function LHFeatures:ApplyJumpLimitValues(humanoid)
    humanoid = humanoid or self:GetHumanoid()
    if not humanoid or humanoid.Health <= 0 then return false end

    local target = self.JumpLimitTargets[humanoid] or self:CaptureJumpLimitValues(humanoid)
    if not target then return false end

    -- Do not force UseJumpPower. Changing the Humanoid jump mode can make the
    -- player jump much higher than the game intended. Preserve and enforce the
    -- values that were already active when the bypass was enabled.
    if target.HasJumpPower then
        pcall(function() humanoid.JumpPower = target.JumpPower end)
    end
    if target.HasJumpHeight then
        pcall(function() humanoid.JumpHeight = target.JumpHeight end)
    end
    return true
end

function LHFeatures:ClearJumpLimitTargets()
    self.JumpLimitTargets = setmetatable({}, {__mode = "k"})
end

function LHFeatures:RestoreNoClip()
    for part, original in pairs(self.NoClipOriginal) do
        if part and part.Parent and part:IsA("BasePart") then
            pcall(function() part.CanCollide = original end)
        end
        self.NoClipOriginal[part] = nil
    end
end

function LHFeatures:BindCharacter(character)
    if self.CharacterDiedConnection then
        pcall(function() self.CharacterDiedConnection:Disconnect() end)
        self.CharacterDiedConnection = nil
    end
    self:RestoreNoClip()
    self.Character = character
    self.Humanoid = nil
    self.Root = nil
    self.Dead = false
    if not character then return end

    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
        local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 10)
        if self.Character ~= character then return end
        self.Humanoid = humanoid
        self.Root = root or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
        if humanoid then
            self.Dead = humanoid.Health <= 0
            self.CharacterDiedConnection = humanoid.Died:Connect(function()
                if self.Character == character then self.Dead = true end
            end)
            if self.JumpLimitBypassEnabled then
                self:CaptureJumpLimitValues(humanoid)
            end
        end
    end)
end

function LHFeatures:SetJumpPower(value)
    value = math.clamp(tonumber(value) or self.UniversalJumpPower or 50, 0, 500)
    self.UniversalJumpPower = value
    env.LHSettings.UniversalJumpPower = value
    local humanoid = self:GetHumanoid()
    if humanoid then
        pcall(function() humanoid.JumpPower = value end)
        if self.JumpLimitBypassEnabled then
            local target = self.JumpLimitTargets[humanoid] or self:CaptureJumpLimitValues(humanoid)
            if target then
                target.HasJumpPower = true
                target.JumpPower = value
            end
        end
    end
    if LHRuntime and not LHRuntime.Unloading then LHRuntime:SettingChanged() end
    return value
end

function LHFeatures:SetNoClip(enabled)
    self.NoClipEnabled = enabled == true
    if not self.NoClipEnabled then self:RestoreNoClip() end
end

function LHFeatures:SetInfiniteJump(enabled)
    self.InfiniteJumpEnabled = enabled == true
end

function LHFeatures:SetAntiSit(enabled)
    self.AntiSitEnabled = enabled == true
end

function LHFeatures:RestoreJumpMode()
    for humanoid, original in pairs(self.JumpModeOriginal) do
        if humanoid and humanoid.Parent then
            pcall(function() humanoid.UseJumpPower = original end)
        end
        self.JumpModeOriginal[humanoid] = nil
    end
    self:ClearJumpLimitTargets()
end

function LHFeatures:SetJumpLimitBypass(enabled)
    self.JumpLimitBypassEnabled = enabled == true
    if self.JumpLimitBypassEnabled then
        -- Capture the current Humanoid values before the loop starts. This keeps
        -- the player's normal jump exactly where the game or LH setter already
        -- placed it instead of forcing a hardcoded JumpPower or jump mode.
        self:ClearJumpLimitTargets()
        self:CaptureJumpLimitValues(self:GetHumanoid())
    else
        self:RestoreJumpMode()
    end
end

function LHFeatures:SetProximityAutoJump(enabled)
    self.ProximityAutoJumpEnabled = enabled == true
    self.ProximityAccumulator = 0
end

function LHFeatures:SetProximityDistance(value)
    self.ProximityDistance = math.clamp(tonumber(value) or 7.5, 1, 100)
    return self.ProximityDistance
end

function LHFeatures:SetProximityTarget(userId)
    self.ProximityTargetUserId = math.max(0, tonumber(userId) or 0)
end

function LHFeatures:Cleanup()
    self.NoClipEnabled = false
    self.InfiniteJumpEnabled = false
    self.AntiSitEnabled = false
    self.JumpLimitBypassEnabled = false
    self.ProximityAutoJumpEnabled = false
    self:RestoreNoClip()
    self:RestoreJumpMode()
    if self.CharacterDiedConnection then pcall(function() self.CharacterDiedConnection:Disconnect() end) end
    self.CharacterDiedConnection = nil
end

LHFeatures:BindCharacter(lp.Character or lp.CharacterAdded:Wait())
LHRuntime:Track(lp.CharacterAdded:Connect(function(character) LHFeatures:BindCharacter(character) end))
LHRuntime:Track(lp.CharacterRemoving:Connect(function(character)
    if LHFeatures.Character == character then
        LHFeatures:RestoreNoClip()
        LHFeatures.Character = nil
        LHFeatures.Humanoid = nil
        LHFeatures.Root = nil
        LHFeatures.Dead = true
    end
end))

LHRuntime:Track(get.UserInputService.JumpRequest:Connect(function()
    if not LHFeatures.InfiniteJumpEnabled or LHRuntime.Unloading then return end
    local humanoid = LHFeatures:GetHumanoid()
    if humanoid and humanoid.Health > 0 then
        pcall(function()
            humanoid.Jump = true
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end
end))

LHRuntime:Track(get.RunService.Stepped:Connect(function(_, delta)
    if LHRuntime.Unloading then return end
    local character = LHFeatures.Character or lp.Character
    local humanoid = LHFeatures:GetHumanoid()

    if LHFeatures.NoClipEnabled and character then
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                if LHFeatures.NoClipOriginal[object] == nil then LHFeatures.NoClipOriginal[object] = object.CanCollide end
                if object.CanCollide then object.CanCollide = false end
            end
        end
    end

    if humanoid and humanoid.Health > 0 then
        if LHFeatures.AntiSitEnabled and (humanoid.Sit or humanoid:GetState() == Enum.HumanoidStateType.Seated) then
            humanoid.Sit = false
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
        if LHFeatures.JumpLimitBypassEnabled then
            LHFeatures:ApplyJumpLimitValues(humanoid)
        end
    end

    if LHFeatures.ProximityAutoJumpEnabled and humanoid and humanoid.Health > 0 then
        LHFeatures.ProximityAccumulator = LHFeatures.ProximityAccumulator + (tonumber(delta) or 0.03)
        if LHFeatures.ProximityAccumulator >= 0.08 then
            LHFeatures.ProximityAccumulator = 0
            local localRoot = LHFeatures:GetRoot()
            local nearby = false
            if localRoot then
                for _, player in ipairs(get.Players:GetPlayers()) do
                    if player ~= lp and (LHFeatures.ProximityTargetUserId == 0 or player.UserId == LHFeatures.ProximityTargetUserId) then
                        local targetCharacter = player.Character
                        local targetRoot = targetCharacter and (targetCharacter:FindFirstChild("HumanoidRootPart") or targetCharacter:FindFirstChild("Torso") or targetCharacter:FindFirstChild("UpperTorso"))
                        if targetRoot and (targetRoot.Position - localRoot.Position).Magnitude <= LHFeatures.ProximityDistance then
                            nearby = true
                            break
                        end
                    end
                end
            end
            if nearby and os.clock() - LHFeatures.LastProximityJump >= 0.48 then
                LHFeatures.LastProximityJump = os.clock()
                pcall(function()
                    humanoid.Jump = true
                    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end)
            end
        end
    end
end))

LHRuntime:AddCleanup(function() LHFeatures:Cleanup() end)

local function normalizeName(text)
    text = tostring(text or "")
    -- Shelf/player dropdown text can be formatted as "@Username | DisplayName".
    local usernamePart = text:match("^%s*@?([^|]+)%s*|")
    if usernamePart and usernamePart ~= "" then text = usernamePart end
    return string.lower(text):gsub("^%s*@", ""):gsub("%s+", "")
end

function LHRuntime:FindPlayer(query)
    query = normalizeName(query)
    if query == "" or query == "me" or query == "self" then return lp end
    local players = get.Players:GetPlayers()
    local localRoot = self:GetRoot()

    local numericUserId = tonumber(query)
    if numericUserId then
        for _, player in ipairs(players) do
            if player.UserId == numericUserId then return player end
        end
    end

    if query == "random" then
        local choices = {}
        for _, player in ipairs(players) do
            if player ~= lp then table.insert(choices, player) end
        end
        return #choices > 0 and choices[math.random(1, #choices)] or nil
    end

    if query == "nearest" or query == "furthest" then
        if not localRoot then return nil end
        local chosen, chosenDistance = nil, nil
        for _, player in ipairs(players) do
            if player ~= lp then
                local character = player.Character
                local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"))
                if root then
                    local distance = (root.Position - localRoot.Position).Magnitude
                    if not chosenDistance or (query == "nearest" and distance < chosenDistance) or (query == "furthest" and distance > chosenDistance) then
                        chosen, chosenDistance = player, distance
                    end
                end
            end
        end
        return chosen
    end

    local exact, starts, contains = {}, {}, {}
    for _, player in ipairs(players) do
        local username = normalizeName(player.Name)
        local display = normalizeName(player.DisplayName)
        if username == query or display == query then
            table.insert(exact, player)
        elseif username:sub(1, #query) == query or display:sub(1, #query) == query then
            table.insert(starts, player)
        elseif string.find(username, query, 1, true) or string.find(display, query, 1, true) then
            table.insert(contains, player)
        end
    end
    local list = #exact > 0 and exact or (#starts > 0 and starts or contains)
    table.sort(list, function(a, b)
        local aExact = normalizeName(a.Name) == query or normalizeName(a.DisplayName) == query
        local bExact = normalizeName(b.Name) == query or normalizeName(b.DisplayName) == query
        if aExact ~= bExact then return aExact end
        return #a.Name < #b.Name
    end)
    return list[1]
end

function LHRuntime:WaitForRoot(player, timeout)
    player = player or lp
    timeout = math.max(0.1, tonumber(timeout) or 3.5)
    local deadline = os.clock() + timeout
    repeat
        if not player or not player.Parent then return nil end
        -- Do not call GetRoot(nil) for another player: GetRoot(nil) correctly
        -- means the LocalPlayer, which previously caused missing targets to
        -- resolve to our own HumanoidRootPart.
        local character = player.Character
        local root = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso"))
        if root then return root end
        task.wait(0.05)
    until os.clock() >= deadline
    return nil
end

function LHRuntime:TeleportToPlayer(target)
    if not target or target == lp then return false, "invalid target" end
    local localRoot = self:WaitForRoot(lp, 4)
    local targetRoot = self:WaitForRoot(target, 4)
    if not localRoot or not targetRoot then return false, "A character root did not load in time" end

    local humanoid = self:GetHumanoid(lp.Character)
    if humanoid then
        pcall(function()
            humanoid.Sit = false
            humanoid.PlatformStand = false
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end

    local moved = false
    local lastError = nil
    for _ = 1, 5 do
        if not target.Parent then return false, "Target left the server" end
        if not localRoot.Parent then localRoot = self:WaitForRoot(lp, 1.5) end
        if not targetRoot.Parent then targetRoot = self:WaitForRoot(target, 1.5) end
        if not localRoot or not targetRoot then break end

        local destination = targetRoot.CFrame * CFrame.new(0, 0.25, 3)
        local ok, err = pcall(function()
            localRoot.AssemblyLinearVelocity = Vector3.zero
            localRoot.AssemblyAngularVelocity = Vector3.zero
            local character = lp.Character
            local pivoted = false
            if character and character.Parent then
                pivoted = pcall(function() character:PivotTo(destination) end)
            end
            if not pivoted then localRoot.CFrame = destination end
        end)
        if ok then
            moved = true
            if (localRoot.Position - targetRoot.Position).Magnitude <= 12 then break end
        else
            lastError = tostring(err)
        end
        task.wait(0.06)
    end

    if not moved then return false, lastError or "Teleport could not move your character" end
    return true
end

function LHRuntime:ExecuteRemote(url, label)
    label = tostring(label or "Remote skript")
    local island = self:ShowIsland(label, "Downloading...", {Progress = 12})
    local okDownload, source = pcall(function() return game:HttpGet(tostring(url), true) end)
    if not okDownload then
        if island and island.Close then island:Close() end
        self:Notify("error", label, "Download failed: " .. tostring(source), 7)
        return false, source
    end
    if island and island.SetProgress then island:SetProgress(55, "Kompiling...") end
    local chunk, compileError = loadstring(source)
    if not chunk then
        if island and island.Close then island:Close() end
        self:Notify("error", label, "Kompile failed: " .. tostring(compileError), 8)
        return false, compileError
    end
    if island and island.SetProgress then island:SetProgress(82, "Starting...") end
    local okRun, runError = xpcall(chunk, function(err) return debug.traceback(tostring(err), 2) end)
    if not okRun then
        if island and island.Close then island:Close() end
        self:Notify("error", label, "Runtime failed: " .. tostring(runError), 8)
        return false, runError
    end
    if island and island.Update then island:Update(label, "Started suxxessfully.", 100); task.delay(1.2, function() island:Close() end) end
    self:Notify("success", label, "Started suxxessfully.", 4)
    return true
end

local function splitWords(text)
    local words = {}
    local current = ""
    local quote = nil
    for index = 1, #text do
        local character = text:sub(index, index)
        if quote then
            if character == quote then quote = nil else current = current .. character end
        elseif character == '"' or character == "'" then
            quote = character
        elseif character:match("%s") then
            if current ~= "" then table.insert(words, current); current = "" end
        else
            current = current .. character
        end
    end
    if current ~= "" then table.insert(words, current) end
    return words
end

function LHRuntime:RegisterCommand(name, aliases, description, usage, callback)
    name = string.lower(tostring(name))
    local command = {
        Name = name,
        Aliases = aliases or {},
        Description = tostring(description or ""),
        Usage = tostring(usage or name),
        Callback = callback,
    }
    self.Commands[name] = command
    table.insert(self.CommandOrder, command)
    -- Earlier LH-native kommands keep priority over later backend aliases.
    -- This prevents Nameless Admin aliases such as "to" and "tp" from
    -- replacing LH's reliable player resolver/teleport implementation.
    for _, alias in ipairs(command.Aliases) do
        local aliasName = string.lower(tostring(alias))
        if aliasName ~= "" and self.Commands[aliasName] == nil then
            self.Commands[aliasName] = command
        end
    end
    return command
end

function LHRuntime:CommandNames()
    local names = {}
    for _, command in ipairs(self.CommandOrder) do table.insert(names, command.Name) end
    table.sort(names)
    return names
end


--==================================================
-- V10.5.0 KUSTOM KOMMAND ALIASES
--==================================================
LHRuntime.CustomAliases = type(env.LHSettings.CommandAliases) == "table" and env.LHSettings.CommandAliases or {}
env.LHSettings.CommandAliases = LHRuntime.CustomAliases

local function normalizeCustomAliasName(value)
    value = string.lower(tostring(value or ""))
    value = value:gsub("^%s+", ""):gsub("%s+$", "")
    value = value:gsub("^[>!/]+", "")
    return value
end

function LHRuntime:ResolveCommandName(name)
    name = normalizeCustomAliasName(name)
    local command = self.Commands[name]
    if command then return command.Name, command end
    local target = type(self.CustomAliases) == "table" and self.CustomAliases[name] or nil
    if target then
        target = normalizeCustomAliasName(target)
        command = self.Commands[target]
        if command then return command.Name, command end
    end
    return name, nil
end

function LHRuntime:AddCommandAlias(commandName, aliasName)
    commandName = normalizeCustomAliasName(commandName)
    aliasName = normalizeCustomAliasName(aliasName)
    local _, command = self:ResolveCommandName(commandName)
    if not command then return false, "Kommand not found: " .. tostring(commandName) end
    if aliasName == "" then return false, "Alias cannot be blank." end
    -- One-character aliases are valid (example: !e). No arbitrary length cap.
    if not aliasName:match("^[%a_][%w_%-]*$") then
        return false, "Alias kan only use letters, numbers, _ or -, and must start with a letter/_ ."
    end
    if self.Commands[aliasName] then
        return false, "That name is already an LH kommand/alias and cannot be replaced."
    end
    local backendReference = rawget(env, "LHNamelessCommandReference")
    if type(backendReference) == "table" and backendReference[aliasName] ~= nil then
        return false, "That name belongs to an existing Admin kommand/alias and cannot be replaced."
    end
    if self.CustomAliases[aliasName] then
        return false, "That kustom alias already exists. Remove it first."
    end
    if aliasName == command.Name then return false, "That is already the kommand name." end
    self.CustomAliases[aliasName] = command.Name
    env.LHSettings.CommandAliases = self.CustomAliases
    local ok, err = self:SaveSettings()
    if not ok and self.SessionSupported then return false, err end
    return true, command.Name
end

function LHRuntime:RemoveCommandAlias(aliasName)
    aliasName = normalizeCustomAliasName(aliasName)
    if not self.CustomAliases[aliasName] then return false, "Kustom alias not found: " .. tostring(aliasName) end
    local target = self.CustomAliases[aliasName]
    self.CustomAliases[aliasName] = nil
    env.LHSettings.CommandAliases = self.CustomAliases
    self:SaveSettings()
    return true, target
end

function LHRuntime:ListCommandAliases()
    local rows = {}
    for aliasName, commandName in pairs(self.CustomAliases or {}) do
        if type(aliasName) == "string" and type(commandName) == "string" then
            rows[#rows + 1] = {Alias = aliasName, Command = commandName}
        end
    end
    table.sort(rows, function(a, b) return a.Alias < b.Alias end)
    return rows
end

function LHRuntime:ExecuteCommand(rawText, source)
    rawText = tostring(rawText or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if rawText == "" then return false, "empty command" end
    if rawText:sub(1, 1) == ">" then
        rawText = rawText:sub(2):gsub("^%s+", "")
    elseif self.Prefix ~= "" and rawText:sub(1, #self.Prefix) == self.Prefix then
        rawText = rawText:sub(#self.Prefix + 1):gsub("^%s+", "")
    elseif source == "chat" then
        return false, "not a command"
    end
    local words = splitWords(rawText)
    local commandName = string.lower(table.remove(words, 1) or "")
    local resolvedName, command = self:ResolveCommandName(commandName)
    if command then commandName = resolvedName end
    if not command then
        self:Notify("warning", "Unknown Kommand", commandName .. " was not found. Use " .. self.Prefix .. "help.", 5)
        return false, "unknown command"
    end
    local ok, result = self:Safe("Kommand " .. command.Name, command.Callback, words, rawText)
    return ok, result
end

