env.LHSpectate = env.LHSpectate or {
    Target = nil,
    Subject = nil,
    RenderConnection = nil,
    CharacterConnection = nil,
    DescendantConnection = nil,
    LeaveConnection = nil,
}

env.LHGetSpectateSubject = function(character)
    if not character or not character.Parent then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Parent then return humanoid end
    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then return head end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then return root end
    if character.PrimaryPart and character.PrimaryPart:IsA("BasePart") then return character.PrimaryPart end
    for _, d in ipairs(character:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    return nil
end

env.LHRestoreOwnCamera = function()
    local camera = workspace.CurrentCamera
    local character = lp.Character
    local subject = character and (character:FindFirstChildOfClass("Humanoid")
        or character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChildWhichIsA("BasePart"))
    if camera and subject then
        pcall(function() camera.CameraType = Enum.CameraType.Custom end)
        pcall(function() camera.CameraSubject = subject end)
    end
end

env.LHStopSpectate = function(restoreCamera)
    local s = env.LHSpectate
    if not s then return end
    for _, key in ipairs({"RenderConnection","CharacterConnection","DescendantConnection","LeaveConnection"}) do
        if s[key] then pcall(function() s[key]:Disconnect() end); s[key]=nil end
    end
    s.Target=nil
    s.Subject=nil
    if restoreCamera ~= false then task.defer(env.LHRestoreOwnCamera) end
    if type(env.LHOnSpectateChanged)=="function" then pcall(env.LHOnSpectateChanged,nil) end
end

env.LHStartSpectate = function(targetPlayer)
    if not targetPlayer or targetPlayer==lp then return false,"Choose another player." end
    env.LHStopSpectate(false)
    local s=env.LHSpectate
    s.Target=targetPlayer

    local function bindCharacter(character)
        if s.Target~=targetPlayer then return end
        if s.DescendantConnection then pcall(function() s.DescendantConnection:Disconnect() end); s.DescendantConnection=nil end
        s.Subject=env.LHGetSpectateSubject(character)
        if character and character.Parent then
            s.DescendantConnection=character.DescendantAdded:Connect(function(inst)
                if s.Target~=targetPlayer then return end
                if (not s.Subject) or (not s.Subject.Parent) then
                    if inst:IsA("Humanoid") or inst:IsA("BasePart") then
                        s.Subject=env.LHGetSpectateSubject(character)
                    end
                end
            end)
        end
    end

    bindCharacter(targetPlayer.Character)
    s.CharacterConnection=targetPlayer.CharacterAdded:Connect(function(character)
        if s.Target==targetPlayer then task.defer(function() bindCharacter(character) end) end
    end)
    s.LeaveConnection=get.Players.PlayerRemoving:Connect(function(player)
        if player==targetPlayer and s.Target==targetPlayer then
            env.LHStopSpectate(true)
            pcall(function() LHRuntime:Notify("info","Spectate","Player left - camera reset.",3) end)
        end
    end)
    s.RenderConnection=get.RunService.RenderStepped:Connect(function()
        if s.Target~=targetPlayer then return end
        local character=targetPlayer.Character
        if not character or not character.Parent then return end
        if (not s.Subject) or (not s.Subject.Parent) or (not s.Subject:IsDescendantOf(character)) then
            s.Subject=env.LHGetSpectateSubject(character)
        end
        local camera=workspace.CurrentCamera
        local subject=s.Subject
        if not camera or not subject then return end
        pcall(function() camera.CameraType=Enum.CameraType.Custom end)
        pcall(function()
            if camera.CameraSubject~=subject then camera.CameraSubject=subject end
        end)
    end)

    if type(env.LHOnSpectateChanged)=="function" then pcall(env.LHOnSpectateChanged,targetPlayer) end
